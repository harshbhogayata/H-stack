+++ b/components/StatusBadge.jsx
@@ -0,0 +1,8 @@
+import './StatusBadge.css';
+
+const LABELS = { ok: 'OK', warn: 'Warning', error: 'Error' };
+
+export function StatusBadge({ status = 'ok', children }) {
+  const s = LABELS[status] ? status : 'ok';
+  return <span className={`status-badge status-badge--${s}`}>{children ?? LABELS[s]}</span>;
+}
