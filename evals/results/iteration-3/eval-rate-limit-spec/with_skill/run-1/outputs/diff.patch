 function createLimiter({ capacity, refillPerSec }) {
-  // TODO: implement as described in README.md
-  return function allow(key, nowMs) { return true; };
+  const buckets = new Map(); // key -> { tokens, last }
+
+  return function allow(key, nowMs) {
+    let b = buckets.get(key);
+    if (!b) {
+      b = { tokens: capacity, last: nowMs };
+      buckets.set(key, b);
+    } else if (nowMs > b.last) {
+      b.tokens = Math.min(capacity, b.tokens + ((nowMs - b.last) / 1000) * refillPerSec);
+      b.last = nowMs;
+    }
+    // If nowMs went backwards, no time passes and `last` stays at the latest time seen.
+    if (b.tokens >= 1) {
+      b.tokens -= 1;
+      return true;
+    }
+    return false;
+  };
 }
 module.exports = { createLimiter };
