diff --git a/lib/settings.js b/lib/settings.js
index cd82365..594d07f 100644
--- a/lib/settings.js
+++ b/lib/settings.js
@@ -1,3 +1,5 @@
-const defaults = require('../config/defaults.json');
+// Shop-wide defaults are shared by every caller in the process, so they are
+// frozen: any attempt to mutate them throws instead of silently leaking state.
+const defaults = Object.freeze({ ...require('../config/defaults.json') });
 function getDefaults() { return defaults; }
 module.exports = { getDefaults };
diff --git a/test/settings.test.js b/test/settings.test.js
new file mode 100644
index 0000000..7dab6bc
--- /dev/null
+++ b/test/settings.test.js
@@ -0,0 +1,13 @@
+const test = require('node:test'); const assert = require('node:assert');
+const { getDefaults } = require('../lib/settings');
+const { createCart, refund } = require('../lib/cart');
+
+test('customer prefs do not leak into shop defaults', () => {
+  createCart({ name: 'ann', prefs: { currency: 'USD', taxRate: 0 } });
+  assert.deepStrictEqual(getDefaults(), { currency: 'EUR', taxRate: 0.2 });
+  assert.strictEqual(refund(1).currency, 'EUR');
+});
+
+test('shop defaults cannot be mutated', () => {
+  assert.throws(() => Object.assign(getDefaults(), { currency: 'USD' }), TypeError);
+});
