diff --git a/test/timezones.test.js b/test/timezones.test.js
new file mode 100644
index 0000000..af26ab3
--- /dev/null
+++ b/test/timezones.test.js
@@ -0,0 +1,52 @@
+// Due dates are calendar dates and must not depend on the timezone of the
+// machine running the code. The rest of the suite only exercises whatever TZ
+// the test runner happens to have (often UTC), so here each case is evaluated
+// in child processes pinned to a spread of timezones, including both extremes
+// of the UTC offset range and zones that observe DST.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { execFileSync } = require('node:child_process');
+const path = require('node:path');
+
+const TIMEZONES = [
+  'UTC',
+  'America/Los_Angeles', // UTC-8/-7, where the bug was reported
+  'Pacific/Pago_Pago', // UTC-11
+  'Pacific/Kiritimati', // UTC+14
+  'Europe/London',
+  'Australia/Lord_Howe', // half-hour DST shift
+];
+
+const CASES = [
+  { invoice: { issued: '2026-03-01', terms: 'net30' }, due: '2026-03-31' },
+  { invoice: { issued: '2026-01-20', terms: 'net15' }, due: '2026-02-04' },
+  { invoice: { issued: '2026-05-12', terms: 'due_on_receipt' }, due: '2026-05-12' },
+  // Crosses the US spring-forward (2026-03-08) and EU change (2026-03-29).
+  { invoice: { issued: '2026-03-01', terms: 'net30' }, due: '2026-03-31' },
+  { invoice: { issued: '2026-03-20', terms: 'net15' }, due: '2026-04-04' },
+  // Crosses the US fall-back (2026-11-01) and a year boundary.
+  { invoice: { issued: '2026-10-25', terms: 'net15' }, due: '2026-11-09' },
+  { invoice: { issued: '2026-12-20', terms: 'net30' }, due: '2027-01-19' },
+  // Leap year.
+  { invoice: { issued: '2028-02-15', terms: 'net15' }, due: '2028-03-01' },
+];
+
+const invoiceModule = path.join(__dirname, '..', 'lib', 'invoice.js');
+const script = `
+  const { dueDate } = require(${JSON.stringify(invoiceModule)});
+  const cases = JSON.parse(process.argv[1]);
+  process.stdout.write(JSON.stringify(cases.map((c) => dueDate(c.invoice))));
+`;
+
+for (const tz of TIMEZONES) {
+  test(`due dates are correct in ${tz}`, () => {
+    const out = execFileSync(process.execPath, ['-e', script, JSON.stringify(CASES)], {
+      env: { ...process.env, TZ: tz },
+      encoding: 'utf8',
+    });
+    const actual = JSON.parse(out);
+    CASES.forEach((c, i) => {
+      assert.equal(actual[i], c.due, `${c.invoice.terms} from ${c.invoice.issued} in ${tz}`);
+    });
+  });
+}
