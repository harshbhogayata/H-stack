diff --git a/src/queue.js b/src/queue.js
index 1d07d0c..2335380 100644
--- a/src/queue.js
+++ b/src/queue.js
@@ -1,8 +1,22 @@
 class Queue {
-  constructor() { this.done = []; }
+  constructor() {
+    this.done = [];
+    this.pending = new Set();
+  }
   push(job) {
     // Jobs finish after a variable delay, like real I/O.
-    setTimeout(() => { this.done.push(job); }, 5 + Math.floor(Math.random() * 40));
+    const p = new Promise((resolve) => {
+      setTimeout(() => { this.done.push(job); resolve(); }, 5 + Math.floor(Math.random() * 40));
+    });
+    this.pending.add(p);
+    p.then(() => this.pending.delete(p));
+    return p;
+  }
+  // Resolves once every job pushed so far (and any pushed while waiting) has finished.
+  async drain() {
+    while (this.pending.size > 0) {
+      await Promise.all(this.pending);
+    }
   }
 }
 module.exports = { Queue };
