diff --git a/lib/settings.js b/lib/settings.js
index db4b0af..a75af63 100644
--- a/lib/settings.js
+++ b/lib/settings.js
@@ -1,7 +1,22 @@
 const path = require('path');
 
+// require() caches the parsed JSON, so the object it returns is shared by every
+// caller. Deep-freeze it so no one can mutate the global defaults, and hand out
+// copies from getDefaults().
+const DEFAULTS = deepFreeze(
+  require(path.join(__dirname, '..', 'config', 'defaults.json'))
+);
+
+function deepFreeze(obj) {
+  for (const value of Object.values(obj)) {
+    if (value && typeof value === 'object') deepFreeze(value);
+  }
+  return Object.freeze(obj);
+}
+
+// Returns a fresh, mutable copy on every call.
 function getDefaults() {
-  return require(path.join(__dirname, '..', 'config', 'defaults.json'));
+  return structuredClone(DEFAULTS);
 }
 
 module.exports = { getDefaults };
