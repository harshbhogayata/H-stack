@@ -0,0 +1,10 @@
+// Regression guard: buildReport must be linear in the number of orders.
+const assert = require('assert');
+const { buildReport } = require('./report');
+const orders = Array.from({ length: 20000 }, (_, i) => ({ customer: 'c' + (i % 5000), amount: i % 97 }));
+const t0 = process.hrtime.bigint();
+const rows = JSON.parse(buildReport(orders));
+const ms = Number(process.hrtime.bigint() - t0) / 1e6;
+assert.strictEqual(rows.length, 5000);
+assert.ok(ms < 200, `buildReport took ${ms.toFixed(1)} ms (budget 200 ms)`);
+console.log(`perf test passed (${ms.toFixed(1)} ms)`);
