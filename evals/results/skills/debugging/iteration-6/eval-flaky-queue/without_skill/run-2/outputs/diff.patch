--- a/src/queue.js
+++ b/src/queue.js
@@ -2,7 +2,10 @@ class Queue {
   constructor() { this.done = []; }
   push(job) {
     // Jobs finish after a variable delay, like real I/O.
-    setTimeout(() => { this.done.push(job); }, 5 + Math.floor(Math.random() * 40));
+    // Returns a promise that resolves once this job has completed.
+    return new Promise((resolve) => {
+      setTimeout(() => { this.done.push(job); resolve(job); }, 5 + Math.floor(Math.random() * 40));
+    });
   }
 }
 module.exports = { Queue };
