diff --git a/src/queue.js b/src/queue.js
index 1d07d0c..a4e6ab6 100644
--- a/src/queue.js
+++ b/src/queue.js
@@ -1,8 +1,26 @@
 class Queue {
-  constructor() { this.done = []; }
+  constructor() {
+    this.done = [];
+    this.pending = 0;
+    this._idleWaiters = [];
+  }
   push(job) {
+    this.pending++;
     // Jobs finish after a variable delay, like real I/O.
-    setTimeout(() => { this.done.push(job); }, 5 + Math.floor(Math.random() * 40));
+    setTimeout(() => {
+      this.done.push(job);
+      this.pending--;
+      if (this.pending === 0) {
+        const waiters = this._idleWaiters;
+        this._idleWaiters = [];
+        waiters.forEach((resolve) => resolve());
+      }
+    }, 5 + Math.floor(Math.random() * 40));
+  }
+  // Resolves once every pushed job has finished.
+  onIdle() {
+    if (this.pending === 0) return Promise.resolve();
+    return new Promise((resolve) => this._idleWaiters.push(resolve));
   }
 }
 module.exports = { Queue };
