--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -2,9 +2,22 @@ const test = require('node:test');
 const assert = require('node:assert/strict');
 const { Queue } = require('../src/queue');
 
+// Poll for a condition instead of sleeping a guessed duration: job latency
+// is variable (5–44ms), so any fixed sleep races against the slowest job.
+async function waitFor(condition, description, timeoutMs = 2000) {
+  const start = Date.now();
+  while (!condition()) {
+    if (Date.now() - start > timeoutMs) {
+      throw new Error(`Timeout waiting for ${description} after ${timeoutMs}ms`);
+    }
+    await new Promise((r) => setTimeout(r, 5));
+  }
+}
+
 test('processes all jobs', async () => {
   const q = new Queue();
   q.push('a'); q.push('b'); q.push('c');
-  await new Promise((r) => setTimeout(r, 25));
+  await waitFor(() => q.done.length >= 3, '3 jobs to finish');
   assert.equal(q.done.length, 3);
+  assert.deepEqual([...q.done].sort(), ['a', 'b', 'c']);
 });
