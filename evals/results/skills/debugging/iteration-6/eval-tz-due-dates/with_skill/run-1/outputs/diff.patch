diff --git a/lib/dates.js b/lib/dates.js
index d5ffd0a..b54dcb9 100644
--- a/lib/dates.js
+++ b/lib/dates.js
@@ -6,10 +6,16 @@ function formatDate(d) {
   return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
 }
 
+// Adds days to a calendar date ('YYYY-MM-DD'). Calendar dates have no timezone,
+// so everything here uses UTC: `new Date('YYYY-MM-DD')` parses as UTC midnight,
+// and mixing that with local-time getters/setters shifts the date by a day in
+// zones west of UTC (e.g. California).
 function addDays(isoDate, days) {
-  const d = new Date(isoDate);
-  d.setDate(d.getDate() + days);
-  return formatDate(d);
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(isoDate);
+  if (!m) throw new Error(`expected a YYYY-MM-DD date, got: ${isoDate}`);
+  const [, y, mo, da] = m.map(Number);
+  const d = new Date(Date.UTC(y, mo - 1, da + days));
+  return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
 }
 
 module.exports = { formatDate, addDays };
diff --git a/test/timezones.test.js b/test/timezones.test.js
new file mode 100644
index 0000000..a918c62
--- /dev/null
+++ b/test/timezones.test.js
@@ -0,0 +1,43 @@
+// Due dates are calendar dates and must not depend on the server's timezone.
+// The bug this guards against (date-only strings parsed as UTC, then read with
+// local-time getters) is invisible when the host runs in UTC, so this test
+// re-runs the date checks under fixed timezones regardless of the host's TZ.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { execFileSync } = require('node:child_process');
+const path = require('node:path');
+
+const ZONES = [
+  'UTC',
+  'America/Los_Angeles', // UTC-8/-7, where customers reported the bug
+  'Pacific/Pago_Pago',   // UTC-11
+  'Pacific/Kiritimati',  // UTC+14
+  'Asia/Kolkata',        // half-hour offset
+  'Australia/Lord_Howe', // half-hour DST shift
+];
+
+const CASES = [
+  ['2026-03-01', 'net30', '2026-03-31'],
+  ['2026-01-20', 'net15', '2026-02-04'],
+  ['2026-05-12', 'due_on_receipt', '2026-05-12'],
+  ['2026-03-01', 'net15', '2026-03-16'], // crosses US DST start (Mar 8)
+  ['2026-10-20', 'net30', '2026-11-19'], // crosses US DST end (Nov 1)
+  ['2026-12-20', 'net15', '2027-01-04'], // crosses year end
+  ['2028-02-15', 'net15', '2028-03-01'], // leap year
+];
+
+const script = `
+  const { dueDate } = require(${JSON.stringify(path.join(__dirname, '../lib/invoice'))});
+  const cases = ${JSON.stringify(CASES)};
+  process.stdout.write(JSON.stringify(cases.map(([issued, terms]) => dueDate({ issued, terms }))));
+`;
+
+for (const tz of ZONES) {
+  test(`due dates are correct in ${tz}`, () => {
+    const out = execFileSync(process.execPath, ['-e', script], {
+      env: { ...process.env, TZ: tz },
+      encoding: 'utf8',
+    });
+    assert.deepEqual(JSON.parse(out), CASES.map((c) => c[2]));
+  });
+}
