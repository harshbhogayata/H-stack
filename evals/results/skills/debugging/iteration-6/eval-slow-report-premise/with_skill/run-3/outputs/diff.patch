 console.log('report test passed');
+
+// Performance guard: 20k orders / 5k customers must not be quadratic (was ~1.7s).
+const big = Array.from({ length: 20000 }, (_, i) => ({ customer: 'c' + (i % 5000), amount: i % 97 }));
+const t0 = process.hrtime.bigint();
+buildReport(big);
+const ms = Number(process.hrtime.bigint() - t0) / 1e6;
+assert.ok(ms < 250, `buildReport too slow: ${ms.toFixed(1)} ms (budget 250 ms)`);
+console.log(`report perf test passed (${ms.toFixed(1)} ms)`);
