diff --git a/lib/settings.js b/lib/settings.js
index db4b0af..f92af9e 100644
--- a/lib/settings.js
+++ b/lib/settings.js
@@ -1,7 +1,22 @@
+const fs = require('fs');
 const path = require('path');
 
+// Loaded once and deep-frozen so no caller can corrupt the shared defaults.
+// Read with fs (not require) so it is not shared via the require cache either.
+const DEFAULTS = deepFreeze(
+  JSON.parse(fs.readFileSync(path.join(__dirname, '..', 'config', 'defaults.json'), 'utf8'))
+);
+
+function deepFreeze(obj) {
+  for (const value of Object.values(obj)) {
+    if (value && typeof value === 'object') deepFreeze(value);
+  }
+  return Object.freeze(obj);
+}
+
+// Returns a fresh, mutable copy on every call; callers may modify it freely.
 function getDefaults() {
-  return require(path.join(__dirname, '..', 'config', 'defaults.json'));
+  return structuredClone(DEFAULTS);
 }
 
 module.exports = { getDefaults };
