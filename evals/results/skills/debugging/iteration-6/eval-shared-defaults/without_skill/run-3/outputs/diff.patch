diff --git a/lib/settings.js b/lib/settings.js
index db4b0af..b656513 100644
--- a/lib/settings.js
+++ b/lib/settings.js
@@ -1,7 +1,21 @@
 const path = require('path');
 
+function deepFreeze(obj) {
+  for (const value of Object.values(obj)) {
+    if (value && typeof value === 'object') deepFreeze(value);
+  }
+  return Object.freeze(obj);
+}
+
+// Loaded once and frozen so no caller can mutate the shared defaults
+// (require() caches the object, so any mutation would leak process-wide).
+const DEFAULTS = deepFreeze(
+  structuredClone(require(path.join(__dirname, '..', 'config', 'defaults.json')))
+);
+
+// Returns a fresh, mutable copy on every call; callers may safely modify it.
 function getDefaults() {
-  return require(path.join(__dirname, '..', 'config', 'defaults.json'));
+  return structuredClone(DEFAULTS);
 }
 
 module.exports = { getDefaults };
