diff --git a/lib/settings.js b/lib/settings.js
index db4b0af..c7182f2 100644
--- a/lib/settings.js
+++ b/lib/settings.js
@@ -1,7 +1,13 @@
 const path = require('path');
 
+// Loaded once and frozen so no caller can mutate the shared defaults.
+const DEFAULTS = Object.freeze(
+  require(path.join(__dirname, '..', 'config', 'defaults.json'))
+);
+
+// Returns a fresh copy each call; callers may safely modify the result.
 function getDefaults() {
-  return require(path.join(__dirname, '..', 'config', 'defaults.json'));
+  return { ...DEFAULTS };
 }
 
 module.exports = { getDefaults };
