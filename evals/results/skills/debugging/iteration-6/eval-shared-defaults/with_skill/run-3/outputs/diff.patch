diff --git a/lib/settings.js b/lib/settings.js
index db4b0af..f71271d 100644
--- a/lib/settings.js
+++ b/lib/settings.js
@@ -1,7 +1,13 @@
 const path = require('path');
 
+// `require` caches the parsed JSON, so every caller would share (and could
+// mutate) one object. Freeze the cached source and hand out copies instead.
+const DEFAULTS = Object.freeze(
+  require(path.join(__dirname, '..', 'config', 'defaults.json'))
+);
+
 function getDefaults() {
-  return require(path.join(__dirname, '..', 'config', 'defaults.json'));
+  return { ...DEFAULTS };
 }
 
 module.exports = { getDefaults };
diff --git a/test/settings.test.js b/test/settings.test.js
new file mode 100644
index 0000000..8922a4f
--- /dev/null
+++ b/test/settings.test.js
@@ -0,0 +1,16 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { getDefaults } = require('../lib/settings');
+const { createCustomer } = require('../lib/customers');
+
+test('mutating the returned defaults does not leak into later calls', () => {
+  const d = getDefaults();
+  try { d.currency = 'JPY'; } catch {}
+  assert.equal(getDefaults().currency, 'EUR');
+});
+
+test('creating a customer with prefs does not change global defaults', () => {
+  createCustomer({ id: 'c2', name: 'Bob', prefs: { currency: 'USD', precision: 0 } });
+  assert.equal(getDefaults().currency, 'EUR');
+  assert.equal(getDefaults().precision, 2);
+});
