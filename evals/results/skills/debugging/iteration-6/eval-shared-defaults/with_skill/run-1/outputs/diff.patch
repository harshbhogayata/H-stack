diff --git a/lib/settings.js b/lib/settings.js
index db4b0af..7877b45 100644
--- a/lib/settings.js
+++ b/lib/settings.js
@@ -1,7 +1,13 @@
 const path = require('path');
 
+// require() caches the parsed JSON and returns the same object to every caller,
+// so handing it out directly lets one caller's mutation (e.g. merging customer
+// prefs into it) silently change the defaults for everyone else. Keep the loaded
+// config frozen and give each caller its own copy.
+const DEFAULTS = Object.freeze(require(path.join(__dirname, '..', 'config', 'defaults.json')));
+
 function getDefaults() {
-  return require(path.join(__dirname, '..', 'config', 'defaults.json'));
+  return structuredClone(DEFAULTS);
 }
 
 module.exports = { getDefaults };
