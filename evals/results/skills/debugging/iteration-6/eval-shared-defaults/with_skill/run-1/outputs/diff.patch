 test('formats a refund', () => {
   assert.equal(refundTotal([{ cents: 500 }, { cents: 250 }]), '-7.50 EUR');
 });
+
+test('customer prefs do not leak into global defaults', () => {
+  createCustomer({ id: 'c2', name: 'Bob', prefs: { currency: 'JPY', precision: 0 } });
+  assert.equal(formatTotal(1230), '12.30 EUR');
+  assert.equal(refundTotal([{ cents: 100 }]), '-1.00 EUR');
+});
+
+test('getDefaults returns an independent copy each call', () => {
+  const { getDefaults } = require('../lib/settings');
+  const a = getDefaults();
+  a.currency = 'XXX';
+  assert.notEqual(getDefaults(), a);
+  assert.equal(getDefaults().currency, 'EUR');
+});
