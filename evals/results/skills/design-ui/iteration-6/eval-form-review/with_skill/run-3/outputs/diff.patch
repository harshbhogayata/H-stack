diff --git a/ui-review.json b/ui-review.json
new file mode 100644
index 0000000..6c822ca
--- /dev/null
+++ b/ui-review.json
@@ -0,0 +1,44 @@
+[
+  {
+    "file": "src/components/SignupForm.jsx",
+    "line": 30,
+    "problem": "The email label points at htmlFor=\"signup-email\" but the input's id is \"email\", so the label isn't linked to the field. Screen readers announce the input with no name, and clicking the label doesn't focus it.",
+    "fix": "Make the ids match: <input id=\"signup-email\" type=\"email\" ... />."
+  },
+  {
+    "file": "src/components/SignupForm.jsx",
+    "line": 18,
+    "problem": "The error from onSubmit is stored in state but never shown. Users get no message saying what went wrong or how to fix it, and screen readers announce nothing.",
+    "fix": "Render the error next to the field or submit button inside a live region, e.g. {error && <p id=\"signup-error\" role=\"alert\" className=\"signup__error\">{error}</p>}, and point the relevant input at it with aria-describedby=\"signup-error\"."
+  },
+  {
+    "file": "src/components/SignupForm.jsx",
+    "line": 34,
+    "problem": "The only sign of an invalid field is a red border (className 'is-invalid'), and it always goes on the password field, even when the error is about the email or the terms. Assistive tech isn't told the field is invalid, and colour alone doesn't convey the state.",
+    "fix": "Track which field the error belongs to. On that input set aria-invalid=\"true\" and aria-describedby pointing at the visible error text, and keep the red border only as an extra cue."
+  },
+  {
+    "file": "src/components/SignupForm.jsx",
+    "line": 40,
+    "problem": "The terms checkbox is a <div onClick> with a styled <span>. You can't focus it or toggle it with the keyboard, it has no checkbox role or checked state for screen readers, and the text isn't an associated label.",
+    "fix": "Use a native checkbox: <label className=\"signup__check\"><input type=\"checkbox\" checked={agreed} onChange={(e) => setAgreed(e.target.checked)} /> I agree to the terms</label>. Style the input itself (or a visually hidden input with a sibling box) so it keeps native focus and semantics."
+  },
+  {
+    "file": "src/components/SignupForm.jsx",
+    "line": 17,
+    "problem": "Submitting has no pending state and no error handling. The 'Create account' button stays enabled during the await, so users can send duplicate signups. If onSubmit throws or rejects, nothing is shown and the promise rejection goes unhandled.",
+    "fix": "Add a submitting state. Set it before the await and clear it in finally. While submitting, disable the button or set aria-disabled with 'Creating account…' text. Wrap the call in try/catch and set a user-facing error on failure."
+  },
+  {
+    "file": "src/components/SignupForm.css",
+    "line": 9,
+    "problem": "The focus style removes the outline and sets border-color to var(--color-border), the same colour as the unfocused border. Keyboard users get no visible focus on the inputs.",
+    "fix": "Use a visible :focus-visible indicator, e.g. .signup input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; } (or set border-color: var(--color-accent) together with a box-shadow ring), and drop outline: none."
+  },
+  {
+    "file": "src/components/SignupForm.css",
+    "line": 4,
+    "problem": "Input borders (and the checkbox box at line 16) use --color-border #a8a29e on the white surface. That is about 2.5:1 contrast, below the 3:1 WCAG 1.4.11 minimum for UI component boundaries, so the field edges are hard to see.",
+    "fix": "Add a darker token in src/styles/theme.css for control borders, e.g. --color-border-strong: #78716c (about 4.8:1 on white), and use it for .signup input and .signup__box."
+  }
+]
