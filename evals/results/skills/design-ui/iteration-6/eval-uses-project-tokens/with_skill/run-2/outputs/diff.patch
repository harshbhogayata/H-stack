diff --git a/settings.css b/settings.css
new file mode 100644
index 0000000..81cf6e9
--- /dev/null
+++ b/settings.css
@@ -0,0 +1,29 @@
+.settings { min-height: 100dvh; background: var(--color-bg); color: var(--color-text); font-family: var(--font-ui); padding: var(--space-6) var(--space-4); padding-bottom: max(var(--space-6), env(safe-area-inset-bottom)); }
+.settings__title { max-width: 560px; margin: 0 auto var(--space-4); font-size: 1.5rem; font-weight: 600; }
+.settings__card { max-width: 560px; margin: 0 auto; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-6); }
+
+.settings__field { display: flex; flex-direction: column; gap: var(--space-1); }
+.settings__field--row { flex-direction: row; align-items: center; justify-content: space-between; gap: var(--space-4); }
+.settings__label { font-weight: 500; }
+.settings__hint { margin: 0; color: var(--color-text-muted); font-size: 0.875rem; }
+
+.settings__input { margin-top: var(--space-1); font: inherit; color: var(--color-text); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius); padding: var(--space-2) var(--space-3); }
+.settings__input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }
+.settings__input[aria-invalid="true"] { border-color: var(--color-danger); }
+.settings__error { margin: 0; color: var(--color-danger); font-size: 0.875rem; }
+
+/* Native checkbox styled as a switch: keeps keyboard (Space) and screen-reader behaviour. */
+.settings__switch { appearance: none; flex-shrink: 0; position: relative; width: 40px; height: 24px; margin: 0; border-radius: 999px; background: var(--color-border); cursor: pointer; transition: background-color 150ms ease; }
+.settings__switch::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: var(--color-text); transition: transform 150ms ease; }
+.settings__switch:checked { background: var(--color-accent); }
+.settings__switch:checked::after { transform: translateX(16px); background: var(--color-bg); }
+.settings__switch:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
+
+.settings__actions { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
+.settings__status { margin: 0 auto 0 0; font-size: 0.875rem; }
+.settings__status--success { color: var(--color-success); }
+.settings__status--error { color: var(--color-danger); }
+
+@media (prefers-reduced-motion: reduce) {
+  .settings__switch, .settings__switch::after { transition: none; }
+}
