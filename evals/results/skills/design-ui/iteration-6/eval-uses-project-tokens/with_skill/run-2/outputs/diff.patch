@@ -0,0 +1,119 @@
+import { useId, useState } from "react";
+import { Button } from "./Button.jsx";
+import "./settings.css";
+
+const MAX_NAME_LENGTH = 50;
+
+/**
+ * Account settings: display name + email notifications.
+ *
+ * Props:
+ *  - initialValues: { displayName?: string, emailNotifications?: boolean }
+ *  - onSave: async ({ displayName, emailNotifications }) => void — throw to show an error.
+ */
+export function SettingsPage({ initialValues = {}, onSave }) {
+  const [displayName, setDisplayName] = useState(initialValues.displayName ?? "");
+  const [emailNotifications, setEmailNotifications] = useState(initialValues.emailNotifications ?? true);
+  const [saved, setSaved] = useState({
+    displayName: initialValues.displayName ?? "",
+    emailNotifications: initialValues.emailNotifications ?? true,
+  });
+  const [status, setStatus] = useState("idle"); // idle | saving | saved | error
+  const [saveError, setSaveError] = useState("");
+  const [touched, setTouched] = useState(false);
+
+  const nameId = useId();
+  const nameHintId = useId();
+  const nameErrorId = useId();
+  const notifyId = useId();
+  const notifyHintId = useId();
+
+  const trimmedName = displayName.trim();
+  const nameError = !trimmedName
+    ? "Enter a display name."
+    : trimmedName.length > MAX_NAME_LENGTH
+      ? `Use ${MAX_NAME_LENGTH} characters or fewer.`
+      : "";
+  const showNameError = touched && nameError;
+  const isDirty = trimmedName !== saved.displayName || emailNotifications !== saved.emailNotifications;
+
+  function markEdited() {
+    if (status === "saved" || status === "error") setStatus("idle");
+  }
+
+  async function handleSubmit(event) {
+    event.preventDefault();
+    setTouched(true);
+    if (nameError || status === "saving") return;
+
+    const values = { displayName: trimmedName, emailNotifications };
+    setStatus("saving");
+    setSaveError("");
+    try {
+      await onSave?.(values);
+      setSaved(values);
+      setDisplayName(trimmedName);
+      setStatus("saved");
+    } catch (err) {
+      setSaveError(err?.message || "Your changes weren't saved. Check your connection and try again.");
+      setStatus("error");
+    }
+  }
+
+  return (
+    <main className="settings">
+      <h1 className="settings__title">Settings</h1>
+
+      <form className="settings__card" onSubmit={handleSubmit} noValidate>
+        <div className="settings__field">
+          <label className="settings__label" htmlFor={nameId}>Display name</label>
+          <p className="settings__hint" id={nameHintId}>Shown to other people on your profile and comments.</p>
+          <input
+            id={nameId}
+            className="settings__input"
+            type="text"
+            name="displayName"
+            autoComplete="nickname"
+            value={displayName}
+            onChange={(e) => { setDisplayName(e.target.value); markEdited(); }}
+            onBlur={() => setTouched(true)}
+            aria-invalid={showNameError ? "true" : undefined}
+            aria-describedby={showNameError ? `${nameHintId} ${nameErrorId}` : nameHintId}
+          />
+          {showNameError && (
+            <p className="settings__error" id={nameErrorId}>{nameError}</p>
+          )}
+        </div>
+
+        <div className="settings__field settings__field--row">
+          <div>
+            <label className="settings__label" htmlFor={notifyId}>Email notifications</label>
+            <p className="settings__hint" id={notifyHintId}>Get an email when someone mentions or replies to you.</p>
+          </div>
+          <input
+            id={notifyId}
+            className="settings__switch"
+            type="checkbox"
+            role="switch"
+            name="emailNotifications"
+            checked={emailNotifications}
+            onChange={(e) => { setEmailNotifications(e.target.checked); markEdited(); }}
+            aria-describedby={notifyHintId}
+          />
+        </div>
+
+        <div className="settings__actions">
+          <p className="settings__status" role="status" aria-live="polite">
+            {status === "saved" && <span className="settings__status--success">Changes saved.</span>}
+            {status === "error" && <span className="settings__status--error">{saveError}</span>}
+          </p>
+          <Button type="submit" disabled={status === "saving" || !isDirty}>
+            {status === "saving" ? "Saving…" : "Save changes"}
+          </Button>
+        </div>
+      </form>
+    </main>
+  );
+}
+
+export default SettingsPage;
