@@ -0,0 +1,130 @@
+import { useId, useState } from "react";
+import { Button } from "./Button";
+import "./theme.css";
+import "./button.css";
+import "./settings.css";
+
+const NAME_MAX = 50;
+
+/**
+ * Settings form for display name and email notifications.
+ *
+ * Props:
+ *   initialValues: { displayName?: string, emailNotifications?: boolean }
+ *   onSave: (values) => void | Promise<void>  — throw/reject to show an error
+ */
+export function SettingsPage({ initialValues = {}, onSave }) {
+  const id = useId();
+  const [displayName, setDisplayName] = useState(initialValues.displayName ?? "");
+  const [emailNotifications, setEmailNotifications] = useState(
+    initialValues.emailNotifications ?? true
+  );
+  const [nameError, setNameError] = useState("");
+  const [saveError, setSaveError] = useState("");
+  const [status, setStatus] = useState("idle"); // idle | saving | saved
+
+  const nameId = `${id}-name`;
+  const nameHintId = `${id}-name-hint`;
+  const nameErrorId = `${id}-name-error`;
+  const notifyId = `${id}-notify`;
+  const notifyHintId = `${id}-notify-hint`;
+
+  function markDirty() {
+    if (status === "saved") setStatus("idle");
+    setSaveError("");
+  }
+
+  async function handleSubmit(event) {
+    event.preventDefault();
+    const trimmed = displayName.trim();
+
+    if (!trimmed) {
+      setNameError("Enter a display name so others know who you are.");
+      return;
+    }
+    if (trimmed.length > NAME_MAX) {
+      setNameError(`Shorten your display name to ${NAME_MAX} characters or fewer.`);
+      return;
+    }
+
+    setNameError("");
+    setSaveError("");
+    setStatus("saving");
+    try {
+      await onSave?.({ displayName: trimmed, emailNotifications });
+      setStatus("saved");
+    } catch {
+      setStatus("idle");
+      setSaveError("Couldn't save your changes. Check your connection and try again.");
+    }
+  }
+
+  return (
+    <form className="settings" onSubmit={handleSubmit} noValidate>
+      <h1>Settings</h1>
+
+      <div className="settings-field">
+        <label htmlFor={nameId}>Display name</label>
+        <p id={nameHintId} className="settings-hint">
+          Shown to others on your profile and comments.
+        </p>
+        <input
+          id={nameId}
+          className="settings-input"
+          type="text"
+          autoComplete="nickname"
+          value={displayName}
+          aria-invalid={nameError ? "true" : undefined}
+          aria-describedby={nameError ? `${nameHintId} ${nameErrorId}` : nameHintId}
+          onChange={(e) => {
+            setDisplayName(e.target.value);
+            if (nameError) setNameError("");
+            markDirty();
+          }}
+        />
+        {nameError && (
+          <p id={nameErrorId} className="settings-error" role="alert">
+            {nameError}
+          </p>
+        )}
+      </div>
+
+      <div className="settings-field settings-toggle">
+        <div>
+          <label htmlFor={notifyId}>Email notifications</label>
+          <p id={notifyHintId} className="settings-hint">
+            Get an email when there's activity on your account.
+          </p>
+        </div>
+        <input
+          id={notifyId}
+          className="settings-switch"
+          type="checkbox"
+          role="switch"
+          checked={emailNotifications}
+          aria-describedby={notifyHintId}
+          onChange={(e) => {
+            setEmailNotifications(e.target.checked);
+            markDirty();
+          }}
+        />
+      </div>
+
+      <div className="settings-actions">
+        <Button type="submit" disabled={status === "saving"}>
+          {status === "saving" ? "Saving…" : "Save changes"}
+        </Button>
+        <p className="settings-status" role="status" aria-live="polite">
+          {status === "saved" ? "Changes saved." : ""}
+        </p>
+        {saveError && (
+          <p className="settings-error" role="alert">
+            {saveError}
+          </p>
+        )}
+      </div>
+    </form>
+  );
+}
+
+export default SettingsPage;
