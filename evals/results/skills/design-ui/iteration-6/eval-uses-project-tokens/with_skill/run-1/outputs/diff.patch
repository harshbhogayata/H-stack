@@ -0,0 +1,34 @@
+.settings {
+  max-width: 32rem;
+  padding: var(--space-4);
+  background: var(--color-surface);
+  color: var(--color-text);
+  border-radius: var(--radius);
+  font-family: var(--font-ui);
+}
+.settings h1 { margin: 0 0 var(--space-4); font-size: 1.25rem; }
+
+.settings-field { display: flex; flex-direction: column; gap: var(--space-1); margin-bottom: var(--space-4); }
+.settings-field label { font-weight: 500; }
+.settings-hint { margin: 0; color: var(--color-text-muted); font-size: 0.875rem; }
+
+.settings-input {
+  padding: var(--space-2);
+  background: var(--color-bg);
+  color: var(--color-text);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius);
+  font: inherit;
+}
+.settings-input[aria-invalid="true"] { border-color: var(--color-danger); }
+
+.settings-toggle { flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--space-3); }
+.settings-toggle > div { display: flex; flex-direction: column; gap: var(--space-1); }
+.settings-switch { width: 1.25rem; height: 1.25rem; margin: 0; flex-shrink: 0; accent-color: var(--color-accent); }
+
+.settings-input:focus-visible,
+.settings-switch:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
+
+.settings-error { margin: 0; color: var(--color-danger); font-size: 0.875rem; }
+.settings-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
+.settings-status { margin: 0; color: var(--color-text-muted); font-size: 0.875rem; }
