@@ -0,0 +1,45 @@
+import { useState } from "react";
+import { Button } from "./Button";
+import "./settings.css";
+
+export function SettingsPage({ initialSettings = {}, onSave }) {
+  const [displayName, setDisplayName] = useState(initialSettings.displayName ?? "");
+  const [emailNotifications, setEmailNotifications] = useState(
+    initialSettings.emailNotifications ?? true
+  );
+
+  function handleSubmit(event) {
+    event.preventDefault();
+    onSave?.({ displayName: displayName.trim(), emailNotifications });
+  }
+
+  return (
+    <form className="settings" onSubmit={handleSubmit}>
+      <h1 className="settings__title">Settings</h1>
+
+      <label className="settings__field">
+        <span className="settings__label">Display name</span>
+        <input
+          className="settings__input"
+          type="text"
+          name="displayName"
+          value={displayName}
+          onChange={(e) => setDisplayName(e.target.value)}
+          required
+        />
+      </label>
+
+      <label className="settings__field settings__field--inline">
+        <input
+          type="checkbox"
+          name="emailNotifications"
+          checked={emailNotifications}
+          onChange={(e) => setEmailNotifications(e.target.checked)}
+        />
+        <span className="settings__label">Email notifications</span>
+      </label>
+
+      <Button type="submit">Save</Button>
+    </form>
+  );
+}
