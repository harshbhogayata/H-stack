diff --git a/src/components/Toast.css b/src/components/Toast.css
new file mode 100644
index 0000000..b4c826e
--- /dev/null
+++ b/src/components/Toast.css
@@ -0,0 +1,46 @@
+.hb-toast-region {
+  position: fixed;
+  right: max(var(--hb-space-4), env(safe-area-inset-right));
+  bottom: max(var(--hb-space-4), env(safe-area-inset-bottom));
+  z-index: var(--hb-z-toast);
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: var(--hb-space-2);
+  width: min(360px, calc(100vw - 2 * var(--hb-space-4)));
+  pointer-events: none; /* the empty region must not block clicks beneath it */
+}
+
+.hb-toast {
+  pointer-events: auto;
+  display: flex;
+  align-items: center;
+  gap: var(--hb-space-2);
+  width: 100%;
+  box-sizing: border-box;
+  padding: var(--hb-space-1) var(--hb-space-1) var(--hb-space-1) var(--hb-space-4);
+  background: var(--hb-color-surface);
+  color: var(--hb-color-ink);
+  border: 1px solid var(--hb-color-border);
+  border-left: var(--hb-space-1) solid var(--hb-color-accent);
+  border-radius: var(--hb-radius);
+  box-shadow: var(--hb-shadow-raised);
+  animation: hb-toast-in var(--hb-motion-base) var(--hb-ease-out);
+}
+
+.hb-toast--success { border-left-color: var(--hb-color-success); }
+.hb-toast--warning { border-left-color: var(--hb-color-warning); }
+
+.hb-toast__message {
+  flex: 1;
+  margin: 0;
+  padding: var(--hb-space-2) 0;
+  overflow-wrap: anywhere;
+}
+
+@keyframes hb-toast-in {
+  from {
+    opacity: 0;
+    transform: translateX(calc(100% + var(--hb-space-4)));
+  }
+}
diff --git a/src/components/Toast.jsx b/src/components/Toast.jsx
