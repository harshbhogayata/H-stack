@@ -0,0 +1,53 @@
+import { useEffect, useRef, useState } from 'react';
+import { IconButton } from './IconButton';
+import { CloseIcon } from './icons';
+import './Toast.css';
+
+/**
+ * Bottom-right notification, e.g. for shipment status changes.
+ *
+ * Keep it mounted and drive it with `message`: pass a string to show it,
+ * and set it back to null in `onClose`. The live region stays in the DOM
+ * between toasts so screen readers reliably announce each new message.
+ *
+ *   const [toast, setToast] = useState(null);
+ *   setToast(`Container ${s.container} is now ${STATUS_LABEL[s.status]}`);
+ *   <Toast message={toast} onClose={() => setToast(null)} />
+ *
+ * The 5s timer pauses while the toast is hovered or has focus, so people
+ * can finish reading or reach the close button, and restarts on leave.
+ */
+export function Toast({ message, onClose, duration = 5000 }) {
+  const [paused, setPaused] = useState(false);
+  const onCloseRef = useRef(onClose);
+  onCloseRef.current = onClose;
+
+  useEffect(() => {
+    if (!message || paused) return undefined;
+    const timer = setTimeout(() => onCloseRef.current?.(), duration);
+    return () => clearTimeout(timer);
+  }, [message, paused, duration]);
+
+  // A new message starts unpaused even if the pointer was over the old one.
+  useEffect(() => setPaused(false), [message]);
+
+  return (
+    <div className="hb-toast-region" role="status" aria-live="polite">
+      {message && (
+        <div
+          key={message}
+          className="hb-toast"
+          onMouseEnter={() => setPaused(true)}
+          onMouseLeave={() => setPaused(false)}
+          onFocus={() => setPaused(true)}
+          onBlur={(e) => {
+            if (!e.currentTarget.contains(e.relatedTarget)) setPaused(false);
+          }}
+        >
+          <p className="hb-toast__message">{message}</p>
+          <IconButton label="Dismiss notification" icon={<CloseIcon />} onClick={() => onClose?.()} />
+        </div>
+      )}
+    </div>
+  );
+}
