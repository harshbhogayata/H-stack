--- /dev/null
+++ b/src/components/Toast.jsx
@@ -0,0 +1,51 @@
+import { useEffect, useRef, useState } from 'react';
+import { IconButton } from './IconButton';
+import { CloseIcon } from './icons';
+import './Toast.css';
+
+/**
+ * Bottom-right notification, e.g. for shipment status changes.
+ *
+ * The live region stays mounted even when there is no message, so screen
+ * readers reliably announce each new message when it's inserted.
+ *
+ *   const [toast, setToast] = useState(null);
+ *   // on status change:
+ *   setToast({ id: Date.now(), text: `${container} is now ${label}` });
+ *   <Toast message={toast?.text} messageKey={toast?.id} onClose={() => setToast(null)} />
+ *
+ * `messageKey` restarts the timer and the slide-in when the same text repeats.
+ * The 5s countdown pauses while the toast is hovered or focused.
+ */
+export function Toast({ message, messageKey, onClose, duration = 5000 }) {
+  const [paused, setPaused] = useState(false);
+  const onCloseRef = useRef(onClose);
+  onCloseRef.current = onClose;
+
+  useEffect(() => {
+    if (!message || paused) return undefined;
+    const timer = setTimeout(() => onCloseRef.current?.(), duration);
+    return () => clearTimeout(timer);
+  }, [message, messageKey, paused, duration]);
+
+  // A new message shouldn't inherit the paused state from the previous one.
+  useEffect(() => setPaused(false), [message, messageKey]);
+
+  return (
+    <div className="hb-toast-region" role="status" aria-live="polite">
+      {message && (
+        <div
+          key={messageKey ?? message}
+          className="hb-toast"
+          onMouseEnter={() => setPaused(true)}
+          onMouseLeave={() => setPaused(false)}
+          onFocus={() => setPaused(true)}
+          onBlur={() => setPaused(false)}
+        >
+          <p className="hb-toast__message">{message}</p>
+          <IconButton label="Dismiss notification" icon={<CloseIcon />} onClick={() => onClose?.()} />
+        </div>
+      )}
+    </div>
+  );
+}
