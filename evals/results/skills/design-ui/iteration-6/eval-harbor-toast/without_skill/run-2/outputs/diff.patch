diff --git a/src/components/Toast.css b/src/components/Toast.css
new file mode 100644
index 0000000..7b419ac
--- /dev/null
+++ b/src/components/Toast.css
@@ -0,0 +1,70 @@
+.hb-toast-region {
+  position: fixed;
+  right: calc(var(--hb-space-4) + env(safe-area-inset-right, 0px));
+  bottom: calc(var(--hb-space-4) + env(safe-area-inset-bottom, 0px));
+  z-index: var(--hb-z-toast);
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: var(--hb-space-2);
+  max-width: calc(100vw - 2 * var(--hb-space-4));
+  /* Let clicks pass through empty space in the region to the page beneath. */
+  pointer-events: none;
+}
+
+.hb-toast {
+  pointer-events: auto;
+  display: flex;
+  align-items: center;
+  gap: var(--hb-space-2);
+  width: 360px;
+  max-width: 100%;
+  box-sizing: border-box;
+  padding: var(--hb-space-1) var(--hb-space-1) var(--hb-space-1) var(--hb-space-4);
+  background: var(--hb-color-surface);
+  color: var(--hb-color-ink);
+  border: 1px solid var(--hb-color-border);
+  border-left: 4px solid var(--hb-color-accent);
+  border-radius: var(--hb-radius);
+  box-shadow: var(--hb-shadow-raised);
+  animation: hb-toast-in var(--hb-motion-base) var(--hb-ease-out) both;
+}
+
+.hb-toast--leaving {
+  animation: hb-toast-out var(--hb-motion-base) var(--hb-ease-out) both;
+}
+
+.hb-toast__message {
+  flex: 1;
+  margin: 0;
+  padding: var(--hb-space-2) 0;
+  font-size: var(--hb-text-sm);
+  overflow-wrap: anywhere;
+}
+
+.hb-toast .hb-icon-button {
+  flex-shrink: 0;
+  color: var(--hb-color-ink-muted);
+}
+
+@keyframes hb-toast-in {
+  from {
+    opacity: 0;
+    transform: translateX(calc(100% + var(--hb-space-4)));
+  }
+  to {
+    opacity: 1;
+    transform: translateX(0);
+  }
+}
+
+@keyframes hb-toast-out {
+  from {
+    opacity: 1;
+    transform: translateX(0);
+  }
+  to {
+    opacity: 0;
+    transform: translateX(calc(100% + var(--hb-space-4)));
+  }
+}
diff --git a/src/components/Toast.jsx b/src/components/Toast.jsx
