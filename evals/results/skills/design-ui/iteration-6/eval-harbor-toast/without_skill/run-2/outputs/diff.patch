@@ -0,0 +1,75 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { IconButton } from './IconButton';
+import { CloseIcon } from './icons';
+import './Toast.css';
+
+const DEFAULT_DURATION = 5000;
+
+/**
+ * Fixed bottom-right stack that hosts toasts. Keep it mounted for the life of
+ * the page: screen readers only announce content added to a live region that
+ * already exists, so mounting the region together with the toast can be missed.
+ */
+export function ToastRegion({ children }) {
+  return (
+    <div className="hb-toast-region" role="status" aria-live="polite" aria-relevant="additions">
+      {children}
+    </div>
+  );
+}
+
+/**
+ * A single notification. Slides in, auto-dismisses after `duration` ms, and can
+ * be closed early with the close button. The timer pauses while the pointer is
+ * over the toast or focus is inside it, so it never vanishes mid-read.
+ * `onClose` fires once the exit animation has finished — remove the toast then.
+ */
+export function Toast({ message, onClose, duration = DEFAULT_DURATION }) {
+  const [leaving, setLeaving] = useState(false);
+  const timerRef = useRef(null);
+  const remainingRef = useRef(duration);
+  const startedAtRef = useRef(0);
+
+  const dismiss = useCallback(() => setLeaving(true), []);
+
+  const startTimer = useCallback(() => {
+    clearTimeout(timerRef.current);
+    startedAtRef.current = Date.now();
+    timerRef.current = setTimeout(dismiss, remainingRef.current);
+  }, [dismiss]);
+
+  const pauseTimer = useCallback(() => {
+    if (timerRef.current === null) return;
+    clearTimeout(timerRef.current);
+    timerRef.current = null;
+    remainingRef.current = Math.max(0, remainingRef.current - (Date.now() - startedAtRef.current));
+  }, []);
+
+  useEffect(() => {
+    remainingRef.current = duration;
+    startTimer();
+    return () => clearTimeout(timerRef.current);
+  }, [duration, startTimer]);
+
+  const handleBlur = (event) => {
+    if (!event.currentTarget.contains(event.relatedTarget)) startTimer();
+  };
+
+  const handleAnimationEnd = (event) => {
+    if (leaving && event.target === event.currentTarget) onClose?.();
+  };
+
+  return (
+    <div
+      className={`hb-toast${leaving ? ' hb-toast--leaving' : ''}`}
+      onMouseEnter={pauseTimer}
+      onMouseLeave={startTimer}
+      onFocus={pauseTimer}
+      onBlur={handleBlur}
+      onAnimationEnd={handleAnimationEnd}
+    >
+      <p className="hb-toast__message">{message}</p>
+      <IconButton label="Dismiss notification" icon={<CloseIcon />} onClick={dismiss} />
+    </div>
+  );
+}
