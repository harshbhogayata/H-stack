@@ -0,0 +1,42 @@
+import { useId } from 'react';
+import { Button } from './Button.jsx';
+import './PlanCard.css';
+
+export function PlanCard({ name, price, features = [], isCurrent = false, onChoose }) {
+  const titleId = useId();
+
+  return (
+    <section
+      className={`plan-card${isCurrent ? ' plan-card--current' : ''}`}
+      aria-labelledby={titleId}
+    >
+      <header className="plan-card__header">
+        <h3 id={titleId} className="plan-card__name">{name}</h3>
+        {isCurrent && <p className="plan-card__badge">Your current plan</p>}
+      </header>
+
+      <p className="plan-card__price">
+        <span className="plan-card__amount">{price}</span>
+        <span className="plan-card__period"> per month</span>
+      </p>
+
+      {features.length > 0 && (
+        <ul className="plan-card__features">
+          {features.map((feature) => (
+            <li key={feature}>{feature}</li>
+          ))}
+        </ul>
+      )}
+
+      {isCurrent ? (
+        <Button variant="secondary" disabled>
+          Current plan
+        </Button>
+      ) : (
+        <Button onClick={onChoose} aria-label={`Choose ${name}`}>
+          Choose
+        </Button>
+      )}
+    </section>
+  );
+}
