diff --git a/src/components/PlanCard.css b/src/components/PlanCard.css
new file mode 100644
index 0000000..6fae8fe
--- /dev/null
+++ b/src/components/PlanCard.css
@@ -0,0 +1,50 @@
+.plan-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  background: var(--surface);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: var(--space-4);
+}
+
+/* Ring via box-shadow so the highlighted card doesn't shift layout. */
+.plan-card--current {
+  border-color: var(--highlight);
+  box-shadow: 0 0 0 1px var(--highlight);
+}
+
+.plan-card__header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--space-2);
+}
+
+.plan-card__name,
+.plan-card__badge,
+.plan-card__price { margin: 0; }
+
+.plan-card__name {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  min-width: 0;
+}
+
+.plan-card__badge { color: var(--highlight); font-weight: 600; }
+
+.plan-card__amount { font-variant-numeric: tabular-nums; font-size: 1.5rem; }
+.plan-card__period { color: var(--text-muted); }
+
+.plan-card__features {
+  margin: 0;
+  padding-left: var(--space-4);
+  display: grid;
+  gap: var(--space-2);
+}
+
+.plan-card .button { margin-top: auto; }
+.plan-card .button:disabled { cursor: default; color: var(--text-muted); }
diff --git a/src/components/PlanCard.jsx b/src/components/PlanCard.jsx
