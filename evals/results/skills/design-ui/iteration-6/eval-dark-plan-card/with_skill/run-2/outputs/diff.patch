diff --git a/src/components/PlanCard.css b/src/components/PlanCard.css
new file mode 100644
index 0000000..5eb6778
--- /dev/null
+++ b/src/components/PlanCard.css
@@ -0,0 +1,36 @@
+.plan-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  background: var(--surface);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: var(--space-4);
+}
+
+/* Inset ring adds weight without changing the card's size next to its siblings. */
+.plan-card--current {
+  border-color: var(--accent);
+  box-shadow: inset 0 0 0 1px var(--accent);
+}
+
+.plan-card__header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--space-2);
+}
+.plan-card__name { margin: 0; }
+.plan-card__badge { margin: 0; color: var(--highlight); font-weight: 600; font-size: 0.875rem; }
+
+.plan-card__price { margin: 0; }
+.plan-card__amount { font-variant-numeric: tabular-nums; font-size: 1.5rem; }
+.plan-card__period { color: var(--text-muted); }
+
+.plan-card__features { margin: 0; padding-left: var(--space-4); flex: 1; }
+.plan-card__features li + li { margin-top: var(--space-2); }
+
+.plan-card .button { align-self: stretch; }
+.plan-card .button:disabled { cursor: default; color: var(--text-muted); }
diff --git a/src/components/PlanCard.jsx b/src/components/PlanCard.jsx
