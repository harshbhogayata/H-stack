diff --git a/src/components/PlanCard.css b/src/components/PlanCard.css
new file mode 100644
index 0000000..8df8128
--- /dev/null
+++ b/src/components/PlanCard.css
@@ -0,0 +1,47 @@
+.plan-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  background: var(--surface);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: var(--space-4);
+}
+
+/* Inset ring on top of the 1px border so the highlight doesn't shift layout. */
+.plan-card--current {
+  border-color: var(--highlight);
+  box-shadow: inset 0 0 0 1px var(--highlight);
+}
+
+.plan-card__header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--space-2);
+}
+
+.plan-card__name { margin: 0; }
+
+.plan-card__badge {
+  color: var(--highlight);
+  font-size: 0.875rem;
+  font-weight: 600;
+}
+
+.plan-card__price { margin: 0; }
+.plan-card__amount { font-variant-numeric: tabular-nums; font-size: 1.5rem; }
+.plan-card__period { color: var(--text-muted); }
+
+.plan-card__features {
+  margin: 0;
+  padding-left: var(--space-4);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+
+.plan-card .button { margin-top: auto; }
+.plan-card .button:disabled { cursor: default; }
diff --git a/src/components/PlanCard.jsx b/src/components/PlanCard.jsx
new file mode 100644
