+++ b/src/components/PlanCard.jsx
@@ -0,0 +1,32 @@
+import { Button } from './Button.jsx';
+import './PlanCard.css';
+
+export function PlanCard({ name, price, features = [], isCurrent = false, onChoose }) {
+  return (
+    <section
+      className={`plan-card${isCurrent ? ' plan-card--current' : ''}`}
+      aria-current={isCurrent ? 'true' : undefined}
+    >
+      <header className="plan-card__header">
+        <h3 className="plan-card__name">{name}</h3>
+        {isCurrent && <span className="plan-card__badge">Current plan</span>}
+      </header>
+      <p className="plan-card__price">
+        <span className="plan-card__amount">{price}</span>
+        <span className="plan-card__period">/month</span>
+      </p>
+      <ul className="plan-card__features">
+        {features.map((feature) => (
+          <li key={feature}>{feature}</li>
+        ))}
+      </ul>
+      <Button
+        variant={isCurrent ? 'secondary' : 'primary'}
+        disabled={isCurrent}
+        onClick={isCurrent ? undefined : onChoose}
+      >
+        {isCurrent ? 'Your plan' : 'Choose'}
+      </Button>
+    </section>
+  );
+}
