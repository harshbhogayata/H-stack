diff --git a/src/components/PlanCard.css b/src/components/PlanCard.css
new file mode 100644
index 0000000..b4352fd
--- /dev/null
+++ b/src/components/PlanCard.css
@@ -0,0 +1,48 @@
+.plan-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  background: var(--surface);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: var(--space-4);
+}
+
+.plan-card--current {
+  border-color: var(--highlight);
+  box-shadow: 0 0 0 1px var(--highlight);
+}
+
+.plan-card__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-2);
+}
+
+.plan-card__name { margin: 0; }
+
+.plan-card__badge {
+  background: var(--highlight);
+  color: var(--surface);
+  border-radius: var(--radius);
+  padding: 2px var(--space-2);
+  font-size: 0.75rem;
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+.plan-card__price { margin: 0; }
+.plan-card__amount { font-variant-numeric: tabular-nums; font-size: 1.5rem; }
+.plan-card__period { color: var(--text-muted); }
+
+.plan-card__features {
+  flex: 1;
+  margin: 0;
+  padding-left: var(--space-4);
+}
+
+.plan-card__features li + li { margin-top: var(--space-2); }
+
+.plan-card .button:disabled { cursor: default; }
diff --git a/src/components/PlanCard.jsx b/src/components/PlanCard.jsx
new file mode 100644
index 0000000..21c4e4d
