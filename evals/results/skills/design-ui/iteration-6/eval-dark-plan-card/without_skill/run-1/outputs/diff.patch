+++ b/src/components/PlanCard.css
@@ -0,0 +1,49 @@
+.plan-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  background: var(--surface);
+  color: var(--text);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: var(--space-4);
+}
+
+.plan-card--current {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 1px var(--accent);
+}
+
+.plan-card__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-2);
+}
+
+.plan-card__name { margin: 0; }
+
+.plan-card__badge {
+  background: var(--accent);
+  color: var(--on-accent);
+  border-radius: var(--radius);
+  padding: 2px var(--space-2);
+  font-size: 0.75rem;
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+.plan-card__price { margin: 0; }
+.plan-card__amount { font-variant-numeric: tabular-nums; font-size: 1.5rem; }
+.plan-card__period { color: var(--text-muted); margin-left: 2px; }
+
+.plan-card__features {
+  margin: 0;
+  padding-left: var(--space-4);
+  flex: 1;
+}
+
+.plan-card__features li + li { margin-top: var(--space-2); }
+
+.plan-card .button { align-self: stretch; }
+.plan-card .button:disabled { cursor: default; }
diff --git a/src/components/PlanCard.jsx b/src/components/PlanCard.jsx
