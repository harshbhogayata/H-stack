+import { useState } from "react";
+import { Button } from "./Button";
+import "./settings.css";
+
+const MAX_NAME_LENGTH = 50;
+
+export function SettingsPage({
+  initialDisplayName = "",
+  initialEmailNotifications = true,
+  onSave,
+}) {
+  const [displayName, setDisplayName] = useState(initialDisplayName);
+  const [emailNotifications, setEmailNotifications] = useState(initialEmailNotifications);
+  const [nameError, setNameError] = useState("");
+  const [status, setStatus] = useState("idle"); // idle | saving | saved | error
+
+  const trimmedName = displayName.trim();
+
+  async function handleSubmit(event) {
+    event.preventDefault();
+
+    if (!trimmedName) {
+      setNameError("Enter a display name so others know who you are.");
+      return;
+    }
+    if (trimmedName.length > MAX_NAME_LENGTH) {
+      setNameError(`Shorten your display name to ${MAX_NAME_LENGTH} characters or fewer.`);
+      return;
+    }
+
+    setNameError("");
+    setStatus("saving");
+    try {
+      await onSave?.({ displayName: trimmedName, emailNotifications });
+      setStatus("saved");
+    } catch {
+      setStatus("error");
+    }
+  }
+
+  function markDirty() {
+    if (status !== "saving") setStatus("idle");
+  }
+
+  return (
+    <main className="settings">
+      <h1 className="settings__title">Settings</h1>
+
+      <form className="settings__card" onSubmit={handleSubmit} noValidate>
+        <div className="settings__field">
+          <label className="settings__label" htmlFor="display-name">
+            Display name
+          </label>
+          <p className="settings__hint" id="display-name-hint">
+            Shown to other people on your profile and in comments.
+          </p>
+          <input
+            id="display-name"
+            className="settings__input"
+            type="text"
+            name="displayName"
+            autoComplete="nickname"
+            value={displayName}
+            onChange={(e) => {
+              setDisplayName(e.target.value);
+              if (nameError) setNameError("");
+              markDirty();
+            }}
+            aria-invalid={nameError ? "true" : undefined}
+            aria-describedby={nameError ? "display-name-hint display-name-error" : "display-name-hint"}
+          />
+          {nameError && (
+            <p className="settings__error" id="display-name-error">
+              {nameError}
+            </p>
+          )}
+        </div>
+
+        <div className="settings__field settings__field--row">
+          <div>
+            <label className="settings__label" htmlFor="email-notifications">
+              Email notifications
+            </label>
+            <p className="settings__hint" id="email-notifications-hint">
+              Get an email when someone replies to you or mentions you.
+            </p>
+          </div>
+          <input
+            id="email-notifications"
+            className="settings__switch"
+            type="checkbox"
+            role="switch"
+            name="emailNotifications"
+            checked={emailNotifications}
+            onChange={(e) => {
+              setEmailNotifications(e.target.checked);
+              markDirty();
+            }}
+            aria-describedby="email-notifications-hint"
+          />
+        </div>
+
+        <div className="settings__actions">
+          <p className="settings__status" role="status" aria-live="polite">
+            {status === "saved" && "Changes saved."}
+            {status === "error" && (
+              <span className="settings__error">
+                Couldn't save your changes. Check your connection and try again.
+              </span>
+            )}
+          </p>
+          <Button type="submit" disabled={status === "saving"} aria-busy={status === "saving"}>
+            {status === "saving" ? "Saving…" : "Save changes"}
+          </Button>
+        </div>
+      </form>
+    </main>
+  );
+}
+
+export default SettingsPage;
