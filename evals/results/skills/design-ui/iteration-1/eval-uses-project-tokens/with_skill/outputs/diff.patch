+++ b/settings.css
@@ -0,0 +1,128 @@
+.settings {
+  max-width: 40rem;
+  margin: 0 auto;
+  padding: 32px 16px;
+  color: var(--color-text);
+  font-family: var(--font-ui);
+}
+
+.settings__title {
+  margin: 0 0 16px;
+  font-size: 1.5rem;
+  font-weight: 600;
+}
+
+.settings__card {
+  display: flex;
+  flex-direction: column;
+  gap: 24px;
+  padding: 24px;
+  background: var(--color-surface);
+  border-radius: var(--radius);
+}
+
+.settings__field {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.settings__field--row {
+  flex-direction: row;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.settings__label {
+  font-weight: 500;
+}
+
+.settings__hint {
+  margin: 0;
+  font-size: 0.875rem;
+  opacity: 0.75;
+  max-width: 60ch;
+}
+
+.settings__input {
+  margin-top: 4px;
+  padding: 8px 10px;
+  font: inherit;
+  color: var(--color-text);
+  background: var(--color-bg);
+  border: 1px solid color-mix(in srgb, var(--color-text) 25%, transparent);
+  border-radius: var(--radius);
+}
+
+.settings__input[aria-invalid="true"] {
+  border-color: var(--color-danger);
+}
+
+.settings__error {
+  margin: 4px 0 0;
+  font-size: 0.875rem;
+  color: var(--color-danger);
+}
+
+/* Native checkbox restyled as a switch: keeps built-in keyboard and form behaviour. */
+.settings__switch {
+  appearance: none;
+  flex-shrink: 0;
+  position: relative;
+  width: 44px;
+  height: 24px;
+  margin: 0;
+  background: var(--color-bg);
+  border: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent);
+  border-radius: 999px;
+  cursor: pointer;
+  transition: background-color 150ms ease;
+}
+
+.settings__switch::before {
+  content: "";
+  position: absolute;
+  top: 3px;
+  left: 3px;
+  width: 16px;
+  height: 16px;
+  border-radius: 50%;
+  background: var(--color-text);
+  transition: transform 150ms ease;
+}
+
+.settings__switch:checked {
+  background: var(--color-accent);
+  border-color: var(--color-accent);
+}
+
+.settings__switch:checked::before {
+  background: var(--color-bg);
+  transform: translateX(20px);
+}
+
+.settings__input:focus-visible,
+.settings__switch:focus-visible {
+  outline: 2px solid var(--color-accent);
+  outline-offset: 2px;
+}
+
+.settings__actions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 16px;
+}
+
+.settings__status {
+  margin: 0;
+  font-size: 0.875rem;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .settings__switch,
+  .settings__switch::before {
+    transition: none;
+  }
+}
