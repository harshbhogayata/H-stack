@@ -0,0 +1,58 @@
+import { useEffect, useRef, useState } from 'react';
+import { IconButton } from './IconButton';
+import { CloseIcon } from './icons';
+import './Toast.css';
+
+/**
+ * Fixed bottom-right live region. Keep it mounted for the page's lifetime and
+ * render a <Toast> inside it when there's something to say: screen readers
+ * only announce changes inside a live region that already exists.
+ */
+export function ToastRegion({ children }) {
+  return (
+    <div className="hb-toast-region" role="status" aria-live="polite">
+      {children}
+    </div>
+  );
+}
+
+/**
+ * A short notice, e.g. "MSCU 482913 is now Delayed". Calls onClose when the
+ * close button is pressed or after `duration` ms. The countdown pauses while
+ * the pointer is over the toast or focus is inside it, so it can be read and
+ * dismissed without racing the timer.
+ *
+ * Give each toast a `key` (e.g. an event id) so a new message restarts the timer.
+ */
+export function Toast({ message, onClose, duration = 5000 }) {
+  const [hovered, setHovered] = useState(false);
+  const [focused, setFocused] = useState(false);
+  const paused = hovered || focused;
+
+  // Keep the latest onClose without restarting the timer on every parent render.
+  const onCloseRef = useRef(onClose);
+  useEffect(() => {
+    onCloseRef.current = onClose;
+  });
+
+  useEffect(() => {
+    if (paused) return undefined;
+    const id = setTimeout(() => onCloseRef.current(), duration);
+    return () => clearTimeout(id);
+  }, [paused, duration]);
+
+  return (
+    <div
+      className="hb-toast"
+      onMouseEnter={() => setHovered(true)}
+      onMouseLeave={() => setHovered(false)}
+      onFocus={() => setFocused(true)}
+      onBlur={(e) => {
+        if (!e.currentTarget.contains(e.relatedTarget)) setFocused(false);
+      }}
+    >
+      <p className="hb-toast__message">{message}</p>
+      <IconButton label="Dismiss notification" icon={<CloseIcon />} onClick={onClose} />
+    </div>
+  );
+}
