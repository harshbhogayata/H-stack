+import { useId, useState } from "react";
+import { Button } from "./Button.jsx";
+import "./settings.css";
+
+const NAME_MAX = 50;
+
+/**
+ * Settings form: display name + email notifications.
+ *
+ * Props:
+ *  - initialValues: { displayName?: string, emailNotifications?: boolean }
+ *  - onSave(values): may return a Promise; a rejection shows its message next to the Save button.
+ */
+export function SettingsPage({ initialValues = {}, onSave }) {
+  const [saved, setSaved] = useState({
+    displayName: initialValues.displayName ?? "",
+    emailNotifications: initialValues.emailNotifications ?? true,
+  });
+  const [displayName, setDisplayName] = useState(saved.displayName);
+  const [emailNotifications, setEmailNotifications] = useState(saved.emailNotifications);
+  const [nameError, setNameError] = useState("");
+  const [status, setStatus] = useState({ state: "idle", message: "" });
+
+  const id = useId();
+  const nameId = `${id}-name`;
+  const nameHintId = `${id}-name-hint`;
+  const nameErrorId = `${id}-name-error`;
+  const notifId = `${id}-notif`;
+  const notifHintId = `${id}-notif-hint`;
+
+  const isDirty =
+    displayName.trim() !== saved.displayName || emailNotifications !== saved.emailNotifications;
+  const isSaving = status.state === "saving";
+
+  function validateName(value) {
+    const trimmed = value.trim();
+    if (!trimmed) return "Enter a display name. This is how others see you.";
+    if (trimmed.length > NAME_MAX) return `Use ${NAME_MAX} characters or fewer.`;
+    return "";
+  }
+
+  async function handleSubmit(event) {
+    event.preventDefault();
+    const error = validateName(displayName);
+    setNameError(error);
+    if (error) {
+      document.getElementById(nameId)?.focus();
+      return;
+    }
+
+    const values = { displayName: displayName.trim(), emailNotifications };
+    setStatus({ state: "saving", message: "Saving…" });
+    try {
+      await onSave?.(values);
+      setSaved(values);
+      setDisplayName(values.displayName);
+      setStatus({ state: "success", message: "Changes saved." });
+    } catch (err) {
+      setStatus({
+        state: "error",
+        message: `Couldn't save your changes${err?.message ? `: ${err.message}` : ""}. Try again.`,
+      });
+    }
+  }
+
+  function clearStatus() {
+    if (status.state !== "idle" && status.state !== "saving") {
+      setStatus({ state: "idle", message: "" });
+    }
+  }
+
+  return (
+    <main className="settings">
+      <h1 className="settings__title">Settings</h1>
+
+      <form className="settings__card" onSubmit={handleSubmit} noValidate>
+        <div className="settings__field">
+          <label className="settings__label" htmlFor={nameId}>
+            Display name
+          </label>
+          <p className="settings__hint" id={nameHintId}>
+            Shown on your profile and next to your activity.
+          </p>
+          <input
+            id={nameId}
+            className="settings__input"
+            type="text"
+            name="displayName"
+            autoComplete="nickname"
+            value={displayName}
+            aria-invalid={nameError ? "true" : undefined}
+            aria-describedby={nameError ? `${nameHintId} ${nameErrorId}` : nameHintId}
+            onChange={(e) => {
+              setDisplayName(e.target.value);
+              if (nameError) setNameError(validateName(e.target.value));
+              clearStatus();
+            }}
+            onBlur={(e) => setNameError(validateName(e.target.value))}
+          />
+          {nameError && (
+            <p className="settings__error" id={nameErrorId}>
+              {nameError}
+            </p>
+          )}
+        </div>
+
+        <div className="settings__field settings__field--row">
+          <div>
+            <label className="settings__label" htmlFor={notifId}>
+              Email notifications
+            </label>
+            <p className="settings__hint" id={notifHintId}>
+              Get an email when something needs your attention.
+            </p>
+          </div>
+          <input
+            id={notifId}
+            className="settings__switch"
+            type="checkbox"
+            role="switch"
+            name="emailNotifications"
+            checked={emailNotifications}
+            aria-describedby={notifHintId}
+            onChange={(e) => {
+              setEmailNotifications(e.target.checked);
+              clearStatus();
+            }}
+          />
+        </div>
+
+        <div className="settings__actions">
+          <p
+            className={`settings__status settings__status--${status.state}`}
+            role={status.state === "error" ? "alert" : "status"}
+          >
+            {status.message}
+          </p>
+          <Button type="submit" disabled={!isDirty || isSaving}>
+            {isSaving ? "Saving…" : "Save changes"}
+          </Button>
+        </div>
+      </form>
+    </main>
+  );
+}
+
+export default SettingsPage;
