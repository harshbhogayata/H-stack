+/* Settings page — built on theme.css tokens. */
+.settings {
+  max-width: 40rem;
+  margin: 0 auto;
+  padding: 32px 16px;
+  font-family: var(--font-ui);
+  color: var(--color-text);
+}
+
+.settings__title {
+  margin: 0 0 16px;
+  font-size: 1.5rem;
+  font-weight: 600;
+}
+
+.settings__card {
+  display: flex;
+  flex-direction: column;
+  gap: 24px;
+  padding: 24px;
+  background: var(--color-surface);
+  border-radius: var(--radius);
+}
+
+.settings__field {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.settings__field--row {
+  flex-direction: row;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+
+.settings__label {
+  font-weight: 600;
+}
+
+.settings__hint {
+  margin: 0;
+  font-size: 0.875rem;
+  color: var(--color-text);
+  opacity: 0.8; /* #e2e8f0 @ 80% on #1e293b stays well above AA */
+}
+
+.settings__input {
+  margin-top: 4px;
+  padding: 8px 12px;
+  font: inherit;
+  color: var(--color-text);
+  background: var(--color-bg);
+  border: 1px solid color-mix(in srgb, var(--color-text) 30%, transparent);
+  border-radius: var(--radius);
+}
+
+.settings__input[aria-invalid="true"] {
+  border-color: #f87171;
+}
+
+/* Native checkbox restyled as a switch; keeps keyboard + screen reader behaviour. */
+.settings__switch {
+  appearance: none;
+  flex-shrink: 0;
+  position: relative;
+  width: 44px;
+  height: 24px;
+  margin: 0;
+  background: color-mix(in srgb, var(--color-text) 30%, transparent);
+  border-radius: 999px;
+  cursor: pointer;
+  transition: background-color 150ms ease;
+}
+
+.settings__switch::after {
+  content: "";
+  position: absolute;
+  top: 3px;
+  left: 3px;
+  width: 18px;
+  height: 18px;
+  background: var(--color-text);
+  border-radius: 50%;
+  transition: transform 150ms ease;
+}
+
+.settings__switch:checked {
+  background: var(--color-accent);
+}
+
+.settings__switch:checked::after {
+  background: var(--color-bg);
+  transform: translateX(20px);
+}
+
+.settings__input:focus-visible,
+.settings__switch:focus-visible,
+.settings .btn:focus-visible {
+  outline: 2px solid var(--color-accent);
+  outline-offset: 2px;
+}
+
+.settings .btn {
+  border: 0;
+  cursor: pointer;
+  font: inherit;
+  font-weight: 600;
+}
+
+.settings .btn:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+.settings__actions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 16px;
+}
+
+.settings__status {
+  margin: 0;
+  font-size: 0.875rem;
+}
+
+.settings__status--success {
+  color: var(--color-accent);
+}
+
+.settings__error,
+.settings__status--error {
+  margin: 0;
+  font-size: 0.875rem;
+  color: #f87171;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .settings__switch,
+  .settings__switch::after {
+    transition: none;
+  }
+}
