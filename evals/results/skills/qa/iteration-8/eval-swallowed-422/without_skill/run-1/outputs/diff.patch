+// E2E: the signup page must only say "You're subscribed" when the server
+// actually accepted the address. Run with: node --test e2e/
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+const ROOT = path.join(__dirname, '..');
+const SUCCESS = /you're subscribed/i;
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, ['server.js'], {
+    cwd: ROOT,
+    env: { ...process.env, PORT: '0' }, // let the OS pick a free port
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start')), 10_000);
+    let out = '';
+    server.stdout.on('data', (chunk) => {
+      out += chunk;
+      const m = out.match(/http:\/\/localhost:(\d+)/);
+      if (m) { clearTimeout(timer); resolve(`http://localhost:${m[1]}`); }
+    });
+    server.on('exit', (code) => reject(new Error(`server exited early (${code})`)));
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+// Submits the form like a user would and returns the API response plus the
+// message the page ends up showing.
+async function signUp(email) {
+  const page = await browser.newPage();
+  try {
+    await page.goto(baseURL);
+    await page.fill('#email', email);
+    const [response] = await Promise.all([
+      page.waitForResponse((r) => r.url().endsWith('/api/subscribe')),
+      page.click('button[type=submit]'),
+    ]);
+    const status = page.locator('#status');
+    await page.waitForFunction(() => {
+      const t = document.querySelector('#status').textContent;
+      return t && !t.includes('Subscribing');
+    });
+    return { httpStatus: response.status(), body: await response.json(), message: (await status.textContent()).trim() };
+  } finally {
+    await page.close();
+  }
+}
+
+test('control: a plain address is accepted and confirmed', async () => {
+  const r = await signUp('jane@example.com');
+  assert.equal(r.httpStatus, 201);
+  assert.match(r.message, SUCCESS);
+});
+
+// Each of these passes the browser's type=email check, so the request is sent,
+// but the server rejects it with 422. The page must not claim success.
+for (const email of [
+  'jane+news@example.com', // plus-addressing: server says "Addresses with + are not supported."
+  'ops@localhost',         // valid per HTML spec, server regex requires a dotted TLD
+  'ivan@example.xn--p1ai', // punycode TLD, server regex allows letters only
+]) {
+  test(`rejected address is not reported as subscribed: ${email}`, async () => {
+    const r = await signUp(email);
+    assert.equal(r.httpStatus, 422, `expected server to reject ${email} (precondition)`);
+    assert.doesNotMatch(r.message, SUCCESS,
+      `page showed "${r.message}" although the server responded ${r.httpStatus} ${JSON.stringify(r.body)}`);
+    assert.equal(r.message, r.body.error, 'page should show the server\'s error message');
+  });
+}
