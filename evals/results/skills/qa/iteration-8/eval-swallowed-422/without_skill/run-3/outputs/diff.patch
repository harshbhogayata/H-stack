+// End-to-end tests for the newsletter signup flow.
+// Run with: node --test e2e/subscribe.test.js
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+const SUCCESS = /you're subscribed/i;
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, ['server.js'], {
+    cwd: path.join(__dirname, '..'),
+    env: { ...process.env, PORT: '0' },
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start')), 10_000);
+    server.once('exit', (code) => reject(new Error(`server exited early (${code})`)));
+    let out = '';
+    server.stdout.on('data', (chunk) => {
+      out += chunk;
+      const m = /listening on (http:\/\/\S+)/.exec(out);
+      if (m) { clearTimeout(timer); resolve(m[1]); }
+    });
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+// Fill the form like a user, submit, and wait for the UI to settle.
+async function subscribe(email) {
+  const page = await browser.newPage();
+  await page.goto(baseURL);
+  await page.fill('#email', email);
+  const [response] = await Promise.all([
+    page.waitForResponse((r) => r.url().endsWith('/api/subscribe')),
+    page.click('button[type=submit]'),
+  ]);
+  await page.waitForFunction(() => !document.querySelector('#status').textContent.includes('…'));
+  const result = {
+    status: response.status(),
+    body: await response.json(),
+    message: (await page.textContent('#status')).trim(),
+  };
+  await page.close();
+  return result;
+}
+
+test('a valid address is accepted and the user is told so', async () => {
+  const r = await subscribe('alice@example.com');
+  assert.equal(r.status, 201);
+  assert.match(r.message, SUCCESS);
+});
+
+// Each of these passes the browser's type="email" check, so the request is sent,
+// but the server rejects it with 422. The page must not claim success.
+for (const email of ['alice+news@example.com', 'a@b.c']) {
+  test(`page does not claim success when the server rejects ${email}`, async () => {
+    const r = await subscribe(email);
+    if (r.status >= 200 && r.status < 300) return; // server accepted it: success message is legitimate
+    assert.doesNotMatch(
+      r.message,
+      SUCCESS,
+      `server answered ${r.status} ${JSON.stringify(r.body)} but the page told the user: "${r.message}"`,
+    );
+    assert.ok(r.message.length > 0, 'the user should be shown why the signup failed');
+  });
+}
