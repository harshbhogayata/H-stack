+// End-to-end test of the newsletter signup flow in a real browser.
+// Run: node --test e2e/subscribe.test.js
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+const SUCCESS = /you're subscribed/i;
+let server;
+let baseUrl;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, ['server.js'], {
+    cwd: path.join(__dirname, '..'),
+    env: { ...process.env, PORT: '0' }, // pick a free port
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseUrl = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start within 10s')), 10_000);
+    server.once('exit', (code) => reject(new Error(`server exited early (code ${code})`)));
+    server.stdout.on('data', (chunk) => {
+      const m = /http:\/\/\S+/.exec(String(chunk));
+      if (m) { clearTimeout(timer); resolve(m[0]); }
+    });
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+// Fill the form, click Subscribe, and return the API response plus the final status text.
+async function subscribe(email) {
+  const page = await browser.newPage();
+  try {
+    await page.goto(baseUrl);
+    await page.fill('#email', email);
+    const [response] = await Promise.all([
+      page.waitForResponse((r) => r.url().endsWith('/api/subscribe') && r.request().method() === 'POST'),
+      page.click('button[type=submit]'),
+    ]);
+    // Wait for the UI to leave the in-flight "Subscribing…" state.
+    await page.waitForFunction(() => {
+      const t = document.getElementById('status').textContent;
+      return t && !t.startsWith('Subscribing');
+    });
+    return {
+      status: response.status(),
+      body: await response.json(),
+      message: (await page.textContent('#status')).trim(),
+      inputValue: await page.inputValue('#email'),
+    };
+  } finally {
+    await page.close();
+  }
+}
+
+test('a valid address is accepted and the user is told they are subscribed', async () => {
+  const r = await subscribe('jane@example.com');
+  assert.equal(r.status, 201);
+  assert.match(r.message, SUCCESS);
+});
+
+// Each of these passes the browser's <input type="email"> check, so the request
+// is sent, but the server rejects it with 422. The page must not claim success.
+for (const [email, reason] of [
+  ['jane+news@example.com', 'plus-addressing is rejected by the server'],
+  ['jane@localhost', 'server requires a dotted domain'],
+  ['jane@example.c', 'server requires a 2+ letter TLD'],
+]) {
+  test(`rejected address ${email} is not reported as subscribed (${reason})`, async () => {
+    const r = await subscribe(email);
+    assert.equal(r.status, 422, `precondition: server should reject ${email}`);
+    assert.doesNotMatch(
+      r.message, SUCCESS,
+      `server returned ${r.status} ${JSON.stringify(r.body)} but the page told the user: "${r.message}"`,
+    );
+    assert.equal(r.message, r.body.error, 'the server\'s error message should be shown to the user');
+    assert.equal(r.inputValue, email, 'the form should keep the address so the user can correct it');
+  });
+}
