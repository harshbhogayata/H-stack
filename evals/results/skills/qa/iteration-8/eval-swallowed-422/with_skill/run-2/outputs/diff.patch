+// E2E: newsletter signup in a real browser.
+// Run: node --test e2e/subscribe.test.js
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, [path.join(__dirname, '..', 'server.js')], {
+    env: { ...process.env, PORT: '0' },
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start')), 10_000);
+    server.once('exit', (code) => reject(new Error(`server exited early (${code})`)));
+    server.stdout.on('data', (chunk) => {
+      const m = /http:\/\/\S+/.exec(String(chunk));
+      if (m) { clearTimeout(timer); resolve(m[0]); }
+    });
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+async function submit(email) {
+  const page = await browser.newPage();
+  await page.goto(baseURL, { waitUntil: 'networkidle' });
+  await page.getByLabel('Email').fill(email);
+  const [response] = await Promise.all([
+    page.waitForResponse((r) => r.url().endsWith('/api/subscribe')),
+    page.getByRole('button', { name: 'Subscribe' }).click(),
+  ]);
+  const status = page.getByRole('status');
+  // Wait until the "Subscribing…" placeholder is replaced by the outcome.
+  await page.waitForFunction(() => {
+    const t = document.getElementById('status').textContent;
+    return t && !t.startsWith('Subscribing');
+  });
+  return { page, response, text: (await status.textContent()).trim() };
+}
+
+test('a valid address is accepted and the page confirms it', async () => {
+  const { page, response, text } = await submit('ana@example.com');
+  assert.equal(response.status(), 201);
+  assert.match(text, /subscribed/i);
+  await page.close();
+});
+
+test('an address the server rejects is not shown as subscribed', async () => {
+  // The server answers 422 "Addresses with + are not supported." for this.
+  const { page, response, text } = await submit('ana+news@example.com');
+  assert.equal(response.status(), 422);
+  assert.doesNotMatch(text, /subscribed/i, `page told the user "${text}" although the API returned 422`);
+  assert.match(text, /\+ are not supported/i, 'page should show the server\'s error message');
+  // The user's input should not be wiped, so they can correct it.
+  assert.equal(await page.getByLabel('Email').inputValue(), 'ana+news@example.com');
+  await page.close();
+});
