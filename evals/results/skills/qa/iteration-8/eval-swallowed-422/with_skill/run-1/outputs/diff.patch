+// E2E: newsletter signup in a real browser.
+// Run: node --test e2e/
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, ['server.js'], {
+    cwd: path.join(__dirname, '..'),
+    env: { ...process.env, PORT: '0' },
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start')), 10000);
+    server.on('exit', (code) => reject(new Error(`server exited early (${code})`)));
+    server.stdout.on('data', (chunk) => {
+      const m = /listening on (http:\/\/\S+)/.exec(String(chunk));
+      if (m) { clearTimeout(timer); resolve(m[1]); }
+    });
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+// Fill the form, submit, and wait for both the API response and the status text to settle.
+async function subscribe(page, email) {
+  await page.goto(baseURL);
+  await page.getByLabel('Email').fill(email);
+  const [response] = await Promise.all([
+    page.waitForResponse((r) => r.url().endsWith('/api/subscribe')),
+    page.getByRole('button', { name: 'Subscribe' }).click(),
+  ]);
+  const status = page.getByRole('status');
+  await page.waitForFunction(() => {
+    const t = document.getElementById('status').textContent;
+    return t && t !== 'Subscribing…';
+  });
+  return { response, statusText: (await status.textContent()).trim() };
+}
+
+test('valid address: server accepts and page confirms', async () => {
+  const page = await browser.newPage();
+  const { response, statusText } = await subscribe(page, 'ada@example.com');
+  assert.equal(response.status(), 201);
+  assert.match(statusText, /subscribed/i);
+  await page.close();
+});
+
+test('address the server rejects (plus-addressing) must not show "subscribed"', async () => {
+  const page = await browser.newPage();
+  const email = 'ada+news@example.com';
+  const { response, statusText } = await subscribe(page, email);
+
+  // Precondition: the server really rejected it, so the user is NOT on the list.
+  assert.equal(response.status(), 422);
+  const { error } = await response.json();
+
+  assert.doesNotMatch(statusText, /subscribed/i, 'page claims success for a rejected signup');
+  assert.equal(statusText, error, 'page should show the server\'s error message');
+  // The user's input should be kept so they can correct it.
+  assert.equal(await page.getByLabel('Email').inputValue(), email);
+  await page.close();
+});
+
+test('address the browser accepts but the server rejects (no TLD) must not show "subscribed"', async () => {
+  const page = await browser.newPage();
+  const { response, statusText } = await subscribe(page, 'ada@localhost');
+  assert.equal(response.status(), 422);
+  assert.doesNotMatch(statusText, /subscribed/i, 'page claims success for a rejected signup');
+  await page.close();
+});
