+// E2E: newsletter signup must only claim success when the server accepted the address.
+// Run: node --test e2e/
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, ['server.js'], {
+    cwd: path.join(__dirname, '..'),
+    env: { ...process.env, PORT: '0' },
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    let out = '';
+    server.stdout.on('data', (chunk) => {
+      out += chunk;
+      const m = out.match(/http:\/\/localhost:(\d+)/);
+      if (m) resolve(`http://localhost:${m[1]}`);
+    });
+    server.once('exit', (code) => reject(new Error(`server exited early (${code})`)));
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+async function subscribe(email) {
+  const page = await browser.newPage();
+  const consoleErrors = [];
+  page.on('console', (m) => { if (m.type() === 'error') consoleErrors.push(m.text()); });
+  await page.goto(baseURL, { waitUntil: 'networkidle' });
+  await page.getByLabel('Email').fill(email);
+  const [response] = await Promise.all([
+    page.waitForResponse((r) => r.url().endsWith('/api/subscribe') && r.request().method() === 'POST'),
+    page.getByRole('button', { name: 'Subscribe' }).click(),
+  ]);
+  const status = page.getByRole('status');
+  await assert.doesNotReject(
+    status.filter({ hasNotText: 'Subscribing' }).waitFor({ timeout: 3000 }),
+    'status message never settled',
+  );
+  const result = { status: response.status(), body: await response.json(), message: (await status.textContent()).trim(), consoleErrors };
+  await page.close();
+  return result;
+}
+
+test('a valid address is accepted and the user is told so', async () => {
+  const r = await subscribe('reader@example.com');
+  assert.equal(r.status, 201);
+  assert.match(r.message, /you're subscribed/i);
+  assert.deepEqual(r.consoleErrors, []);
+});
+
+// These addresses pass the browser's type="email" check but the server rejects them with 422.
+// The page must not tell these people they're subscribed.
+for (const [email, serverError] of [
+  ['jane+news@example.com', 'Addresses with + are not supported.'],
+  ['me@localhost', 'Enter a valid email address.'],
+]) {
+  test(`server-rejected address ${email} is not shown as subscribed`, async () => {
+    const r = await subscribe(email);
+    assert.equal(r.status, 422, 'precondition: server rejects this address');
+    assert.equal(r.body.error, serverError);
+    assert.doesNotMatch(r.message, /subscribed/i, `UI said "${r.message}" although the server answered 422`);
+    assert.notEqual(r.message, '', 'UI should tell the user the signup did not go through');
+  });
+}
