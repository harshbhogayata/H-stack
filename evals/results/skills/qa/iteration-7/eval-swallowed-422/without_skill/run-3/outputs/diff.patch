+// E2E: newsletter signup must not claim success when the server rejected the address.
+// Run: node --test e2e/subscribe.test.js
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, [path.join(__dirname, '..', 'server.js')], {
+    env: { ...process.env, PORT: '0' }, // ephemeral port; read the real one from the log line
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start')), 10_000);
+    let out = '';
+    server.stdout.on('data', (chunk) => {
+      out += chunk;
+      const m = out.match(/http:\/\/localhost:(\d+)/);
+      if (m) { clearTimeout(timer); resolve(`http://localhost:${m[1]}`); }
+    });
+    server.once('exit', (code) => reject(new Error(`server exited early (${code})`)));
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+// Submit through the real UI and return { status, body, message } once the page has reacted.
+async function subscribe(email) {
+  const page = await browser.newPage();
+  try {
+    await page.goto(baseURL);
+    await page.fill('#email', email);
+    const [response] = await Promise.all([
+      page.waitForResponse((r) => r.url().endsWith('/api/subscribe')),
+      page.click('button[type=submit]'),
+    ]);
+    const statusEl = page.locator('#status');
+    await page.waitForFunction(() => document.getElementById('status').textContent !== 'Subscribing…');
+    return { status: response.status(), body: await response.json(), message: await statusEl.textContent() };
+  } finally {
+    await page.close();
+  }
+}
+
+test('control: a plain address is accepted and the page confirms it', async () => {
+  const r = await subscribe('reader@example.com');
+  assert.equal(r.status, 201);
+  assert.match(r.message, /subscribed/i);
+});
+
+// Each of these passes the browser's own type=email check, so the request is sent,
+// but the server rejects it with 422. The page must not tell the user they're subscribed.
+for (const email of [
+  'jane+news@example.com', // plus-addressing: server says "Addresses with + are not supported."
+  'ops@localhost',         // no dot-TLD: server says "Enter a valid email address."
+]) {
+  test(`rejected address ${email} is not reported as subscribed`, async () => {
+    const r = await subscribe(email);
+    assert.equal(r.status, 422, 'precondition: server rejects this address');
+    assert.doesNotMatch(r.message, /subscribed/i,
+      `page claimed success for an address the server rejected (${r.status}): "${r.message}"`);
+    assert.ok(r.message.includes(r.body.error),
+      `page should show the server's reason "${r.body.error}", got "${r.message}"`);
+  });
+}
