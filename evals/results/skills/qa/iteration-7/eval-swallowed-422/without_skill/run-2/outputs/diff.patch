+// End-to-end tests for the newsletter signup flow, driven in a real browser.
+// Run: node --test e2e/
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, [path.join(__dirname, '..', 'server.js')], {
+    env: { ...process.env, PORT: '0' }, // random free port
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start')), 10000);
+    let out = '';
+    server.stdout.on('data', (chunk) => {
+      out += chunk;
+      const m = out.match(/listening on (http:\/\/\S+)/);
+      if (m) { clearTimeout(timer); resolve(m[1]); }
+    });
+    server.on('exit', (code) => reject(new Error(`server exited with ${code}`)));
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+// Fill the form like a user, submit, and return the API response plus the final status text.
+async function subscribe(email) {
+  const page = await browser.newPage();
+  try {
+    await page.goto(baseURL);
+    await page.fill('#email', email);
+    const [response] = await Promise.all([
+      page.waitForResponse((r) => r.url().endsWith('/api/subscribe')),
+      page.click('button[type=submit]'),
+    ]);
+    const status = page.locator('#status');
+    await page.waitForFunction(() => {
+      const t = document.getElementById('status').textContent;
+      return t && t !== 'Subscribing…';
+    });
+    return { httpStatus: response.status(), body: await response.json(), text: await status.textContent() };
+  } finally {
+    await page.close();
+  }
+}
+
+test('control: a normal address is accepted and the page confirms it', async () => {
+  const r = await subscribe('reader@example.com');
+  assert.equal(r.httpStatus, 201);
+  assert.match(r.text, /subscribed/i);
+});
+
+test('plus-addressed email rejected by the server must not show "You\'re subscribed"', async () => {
+  const r = await subscribe('reader+news@example.com');
+  assert.equal(r.httpStatus, 422, 'precondition: server rejects plus-addresses');
+  assert.doesNotMatch(r.text, /subscribed/i,
+    `server answered ${r.httpStatus} ${JSON.stringify(r.body)} but the page told the user: "${r.text}"`);
+  assert.ok(r.text.includes(r.body.error), `expected the server error to be shown, got: "${r.text}"`);
+});
+
+test('address that passes browser validation but fails server validation shows the error', async () => {
+  // Valid for <input type=email>, but the server's TLD rule requires letters only.
+  const r = await subscribe('reader@example.c0m');
+  assert.equal(r.httpStatus, 422, 'precondition: server rejects this address');
+  assert.doesNotMatch(r.text, /subscribed/i,
+    `server answered ${r.httpStatus} ${JSON.stringify(r.body)} but the page told the user: "${r.text}"`);
+});
