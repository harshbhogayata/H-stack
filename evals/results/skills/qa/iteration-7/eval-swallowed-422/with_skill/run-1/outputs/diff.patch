+// E2E: newsletter signup in a real (headless Chromium) browser.
+// Run: node --test e2e/
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+const ROOT = path.join(__dirname, '..');
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, ['server.js'], {
+    cwd: ROOT,
+    env: { ...process.env, PORT: '0' }, // pick a free port
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start')), 10000);
+    let out = '';
+    server.stdout.on('data', (chunk) => {
+      out += chunk;
+      const m = out.match(/listening on (http:\/\/\S+)/);
+      if (m) { clearTimeout(timer); resolve(m[1]); }
+    });
+    server.on('exit', (code) => reject(new Error(`server exited early (${code})`)));
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+// Submits the form like a user and returns what the API said and what the page shows.
+async function subscribe(email) {
+  const page = await browser.newPage();
+  const consoleErrors = [];
+  page.on('console', (m) => { if (m.type() === 'error') consoleErrors.push(m.text()); });
+  try {
+    await page.goto(baseURL, { waitUntil: 'networkidle' });
+    await page.getByLabel('Email').fill(email);
+    const [response] = await Promise.all([
+      page.waitForResponse((r) => r.url().endsWith('/api/subscribe')),
+      page.getByRole('button', { name: 'Subscribe' }).click(),
+    ]);
+    const status = page.getByRole('status');
+    await page.waitForFunction(
+      () => { const t = document.getElementById('status').textContent; return t && t !== 'Subscribing…'; },
+    );
+    return { apiStatus: response.status(), apiBody: await response.json(), shown: await status.textContent(), consoleErrors };
+  } finally {
+    await page.close();
+  }
+}
+
+test('a valid address is accepted and the page confirms it', async () => {
+  const r = await subscribe('reader@example.com');
+  assert.equal(r.apiStatus, 201);
+  assert.match(r.shown, /subscribed/i);
+});
+
+// Addresses the browser's type=email check lets through but the server rejects.
+for (const email of ['jane+news@example.com', 'jane@localhost']) {
+  test(`a rejected address (${email}) is not reported as subscribed`, async () => {
+    const r = await subscribe(email);
+    assert.equal(r.apiStatus, 422, 'precondition: server rejects this address');
+    assert.doesNotMatch(
+      r.shown,
+      /subscribed/i,
+      `server rejected with "${r.apiBody.error}" but the page told the user: "${r.shown}"`,
+    );
+    assert.ok(r.shown.includes(r.apiBody.error), `page should show the server's reason ("${r.apiBody.error}"), got "${r.shown}"`);
+  });
+}
