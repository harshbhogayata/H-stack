+// E2E: newsletter signup in a real browser (Chromium via Playwright).
+// Run: node --test e2e/
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+const SUCCESS = /you're subscribed/i;
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, [path.join(__dirname, '..', 'server.js')], {
+    env: { ...process.env, PORT: '0' },
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start within 10s')), 10_000);
+    let out = '';
+    server.stdout.on('data', (chunk) => {
+      out += chunk;
+      const m = out.match(/listening on (http:\/\/\S+)/);
+      if (m) { clearTimeout(timer); resolve(m[1]); }
+    });
+    server.on('exit', (code) => { clearTimeout(timer); reject(new Error(`server exited early (${code})`)); });
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+// Fill the form, submit, and return what the user sees plus what the API said.
+async function subscribe(email) {
+  const page = await browser.newPage();
+  const consoleErrors = [];
+  page.on('console', (m) => { if (m.type() === 'error') consoleErrors.push(m.text()); });
+  page.on('pageerror', (e) => consoleErrors.push(String(e)));
+  try {
+    await page.goto(baseURL);
+    await page.getByLabel('Email').fill(email);
+    const [response] = await Promise.all([
+      page.waitForResponse((r) => r.url().endsWith('/api/subscribe')),
+      page.getByRole('button', { name: 'Subscribe' }).click(),
+    ]);
+    const status = page.getByRole('status');
+    await page.waitForFunction(() => {
+      const t = document.getElementById('status').textContent;
+      return t && !t.startsWith('Subscribing');
+    });
+    return {
+      apiStatus: response.status(),
+      apiBody: await response.json(),
+      statusText: (await status.textContent()).trim(),
+      fieldValue: await page.getByLabel('Email').inputValue(),
+      consoleErrors,
+    };
+  } finally {
+    await page.close();
+  }
+}
+
+test('a valid address is accepted and the user is told they are subscribed', async () => {
+  const r = await subscribe('jane@example.com');
+  assert.equal(r.apiStatus, 201);
+  assert.match(r.statusText, SUCCESS);
+  assert.equal(r.fieldValue, '', 'form should be cleared after success');
+});
+
+// The browser's type=email check accepts these, so the request reaches the
+// server, which rejects them with 422. The page must not claim success.
+for (const [email, serverError] of [
+  ['jane+news@example.com', 'Addresses with + are not supported.'],
+  ['jane@example.c', 'Enter a valid email address.'],
+]) {
+  test(`server rejection of ${email} is shown to the user, not "You're subscribed"`, async () => {
+    const r = await subscribe(email);
+    assert.equal(r.apiStatus, 422, 'precondition: the API rejects this address');
+    assert.equal(r.apiBody.error, serverError);
+    assert.doesNotMatch(r.statusText, SUCCESS, `UI claimed success although the API returned ${r.apiStatus}`);
+    assert.equal(r.statusText, serverError, 'the server error message should be shown');
+    assert.equal(r.fieldValue, email, 'the address should stay in the field so the user can correct it');
+  });
+}
