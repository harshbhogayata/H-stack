+// E2E: newsletter signup in a real browser.
+// Run: node --test e2e/
+// Starts `node server.js` on a random port, drives the page with Playwright (Chromium headless).
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { spawn } = require('node:child_process');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+const SUCCESS = /you're subscribed/i;
+let server;
+let baseURL;
+let browser;
+
+before(async () => {
+  server = spawn(process.execPath, ['server.js'], {
+    cwd: path.join(__dirname, '..'),
+    env: { ...process.env, PORT: '0' },
+    stdio: ['ignore', 'pipe', 'inherit'],
+  });
+  baseURL = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('server did not start within 10s')), 10_000);
+    server.once('exit', (code) => reject(new Error(`server exited early (code ${code})`)));
+    server.stdout.on('data', (chunk) => {
+      const m = /http:\/\/localhost:\d+/.exec(String(chunk));
+      if (m) { clearTimeout(timer); resolve(m[0]); }
+    });
+  });
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser?.close();
+  server?.kill();
+});
+
+// Fill the form, submit, and return what the user ends up seeing plus what the API said.
+async function subscribe(email) {
+  const page = await browser.newPage();
+  const consoleErrors = [];
+  const failedRequests = [];
+  page.on('console', (m) => { if (m.type() === 'error') consoleErrors.push(m.text()); });
+  page.on('pageerror', (e) => consoleErrors.push(String(e)));
+  page.on('requestfailed', (r) => failedRequests.push(r.url()));
+  try {
+    await page.goto(`${baseURL}/`, { waitUntil: 'networkidle' });
+    await page.getByLabel('Email').fill(email);
+    const [response] = await Promise.all([
+      page.waitForResponse((r) => r.url().endsWith('/api/subscribe') && r.request().method() === 'POST'),
+      page.getByRole('button', { name: 'Subscribe' }).click(),
+    ]);
+    const status = page.getByRole('status');
+    // Wait for the request to settle in the UI (leave the "Subscribing…" state).
+    await page.waitForFunction(() => {
+      const t = document.getElementById('status').textContent;
+      return t && !t.includes('Subscribing');
+    });
+    return {
+      httpStatus: response.status(),
+      body: await response.json(),
+      message: (await status.textContent()).trim(),
+      inputValue: await page.getByLabel('Email').inputValue(),
+      consoleErrors,
+      failedRequests,
+    };
+  } finally {
+    await page.close();
+  }
+}
+
+test('a valid address is accepted and the user is told so', async () => {
+  const r = await subscribe('jane@example.com');
+  assert.equal(r.httpStatus, 201);
+  assert.match(r.message, SUCCESS);
+  assert.deepEqual(r.consoleErrors, []);
+  assert.deepEqual(r.failedRequests, []);
+});
+
+// The bug: the browser accepts these (type=email passes), the server rejects them with 422,
+// but the page still says "You're subscribed" and clears the field. No email ever arrives.
+for (const email of ['jane+news@example.com', 'jane@localhost']) {
+  test(`a rejected address (${email}) is not shown as subscribed`, async () => {
+    const r = await subscribe(email);
+    assert.equal(r.httpStatus, 422, 'precondition: server rejects this address');
+    assert.doesNotMatch(r.message, SUCCESS, `UI claimed success although the API returned ${r.httpStatus}`);
+    assert.equal(r.message, r.body.error, 'UI should show the server\'s error message');
+    assert.equal(r.inputValue, email, 'the address should stay in the field so the user can correct it');
+  });
+}
