+{
+  "spec": "SPEC.md",
+  "target": "todo.js",
+  "check_all": "node check.mjs",
+  "done_when": "node check.mjs exits 0 and its last line is \"RESULT: 3/3 PASS\"",
+  "rules": [
+    "Flip passes to true only after `node check.mjs <id>` passes on a run made after the last edit to todo.js.",
+    "Do not edit check.mjs, SPEC.md, or the id/behaviour/check fields below.",
+    "Leave todos.json in the repo as [] (checks run in temp copies)."
+  ],
+  "features": [
+    {
+      "id": "F1",
+      "spec_item": 1,
+      "behaviour": "`node todo.js add \"x\"` appends x to todos.json and prints \"added: x\"",
+      "check": "node check.mjs F1",
+      "passes": false
+    },
+    {
+      "id": "F2",
+      "spec_item": 2,
+      "behaviour": "`node todo.js list` prints todos numbered from 1 (one per line, number then text; empty list exits 0)",
+      "check": "node check.mjs F2",
+      "passes": false
+    },
+    {
+      "id": "F3",
+      "spec_item": 3,
+      "behaviour": "`node todo.js done 1` removes item 1 from todos.json and prints \"done: <text>\"; remaining items renumber from 1",
+      "check": "node check.mjs F3",
+      "passes": false
+    }
+  ]
+}
