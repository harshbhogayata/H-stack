+#!/usr/bin/env bash
+# Release steps from NOTES.md, in order. Stops at the first failure, so a
+# release is never tagged if the build or the bundle-size check fails.
+#
+# Usage: npm run release            (or: scripts/release.sh)
+#        MAX_KB=300 npm run release (override the bundle limit)
+set -euo pipefail
+
+cd "$(dirname "$0")/.."
+
+MAX_KB="${MAX_KB:-250}"
+VERSION="$(node -p 'require("./package.json").version')"
+TAG="v${VERSION}"
+
+if git rev-parse -q --verify "refs/tags/${TAG}" >/dev/null; then
+  echo "release: tag ${TAG} already exists; bump the version in package.json first." >&2
+  exit 1
+fi
+
+echo "==> 1/4 Build"
+npm run build
+
+echo "==> 2/4 Check bundle size (max ${MAX_KB} KB)"
+node scripts/check-bundle-size.js --max-kb "${MAX_KB}"
+
+echo "==> 3/4 Tag ${TAG}"
+git tag "${TAG}"
+
+echo "==> 4/4 Changelog"
+npm run changelog -- --since-last-tag
+
+echo "==> Released ${TAG}"
