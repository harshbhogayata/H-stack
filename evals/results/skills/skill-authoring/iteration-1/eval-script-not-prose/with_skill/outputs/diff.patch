@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# Release: build -> bundle-size gate -> tag -> changelog.
+# Captures the steps from NOTES.md. The size gate is mandatory: a skipped
+# check once shipped a 400 KB bundle, so the tag is only created after it passes.
+#
+# Usage: scripts/release.sh [--dry-run]
+#   MAX_KB=250 (env) overrides the bundle-size limit.
+set -euo pipefail
+
+MAX_KB="${MAX_KB:-250}"
+DRY_RUN=0
+if [[ "${1:-}" == "--dry-run" ]]; then DRY_RUN=1; fi
+
+cd "$(git rev-parse --show-toplevel)"
+
+VERSION="$(node -p 'require("./package.json").version')"
+TAG="v${VERSION}"
+
+if git rev-parse -q --verify "refs/tags/${TAG}" >/dev/null; then
+  echo "release: tag ${TAG} already exists; bump the version in package.json first." >&2
+  exit 1
+fi
+
+run() {
+  echo "+ $*"
+  if [[ $DRY_RUN -eq 0 ]]; then "$@"; fi
+}
+
+run npm run build
+run node scripts/check-bundle-size.js --max-kb "${MAX_KB}"
+run git tag "${TAG}"
+run npm run changelog -- --since-last-tag
+
+if [[ $DRY_RUN -eq 1 ]]; then
+  echo "release: ${TAG} (dry run, nothing executed)"
+else
+  echo "release: ${TAG} done"
+fi
diff --git a/scripts/release.test.mjs b/scripts/release.test.mjs
new file mode 100644
index 0000000..f89df1a
--- /dev/null
+++ b/scripts/release.test.mjs
@@ -0,0 +1,74 @@
+// Run: npm run test:release
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { execFileSync, spawnSync } from "node:child_process";
+import { mkdtempSync, cpSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const repo = join(dirname(fileURLToPath(import.meta.url)), "..");
+const { version } = JSON.parse(
+  execFileSync("node", ["-p", "JSON.stringify(require('./package.json'))"], { cwd: repo }).toString(),
+);
+const tag = `v${version}`;
+
+// Throwaway git repo with this project's package.json and scripts, so tags never touch the real repo.
+function sandbox() {
+  const dir = mkdtempSync(join(tmpdir(), "release-test-"));
+  cpSync(join(repo, "package.json"), join(dir, "package.json"));
+  cpSync(join(repo, "scripts"), join(dir, "scripts"), { recursive: true });
+  const git = (...a) =>
+    execFileSync("git", ["-c", "user.email=t@t", "-c", "user.name=t", ...a], { cwd: dir, stdio: "pipe" });
+  git("init", "-q");
+  git("add", ".");
+  git("commit", "-qm", "init");
+  return {
+    dir,
+    git,
+    tags: () => git("tag").toString().trim(),
+    release: (...args) => spawnSync("bash", ["scripts/release.sh", ...args], { cwd: dir, encoding: "utf8" }),
+    cleanup: () => rmSync(dir, { recursive: true, force: true }),
+  };
+}
+
+function withSandbox(fn) {
+  const s = sandbox();
+  try { fn(s); } finally { s.cleanup(); }
+}
+
+test("runs the NOTES.md steps in order and tags v<version>", () => withSandbox((s) => {
+  const r = s.release();
+  assert.equal(r.status, 0, r.stderr);
+  const steps = r.stdout.split("\n").filter((l) => l.startsWith("+ "));
+  assert.deepEqual(steps, [
+    "+ npm run build",
+    "+ node scripts/check-bundle-size.js --max-kb 250",
+    `+ git tag ${tag}`,
+    "+ npm run changelog -- --since-last-tag",
+  ]);
+  assert.equal(s.tags(), tag);
+}));
+
+test("oversized bundle stops the release before tagging", () => withSandbox((s) => {
+  writeFileSync(join(s.dir, "scripts/check-bundle-size.js"),
+    'console.error("bundle 400 KB > 250 KB"); process.exit(1)');
+  const r = s.release();
+  assert.notEqual(r.status, 0);
+  assert.equal(s.tags(), "");
+  assert.doesNotMatch(r.stdout, /changelog/);
+}));
+
+test("refuses when the tag already exists", () => withSandbox((s) => {
+  s.git("tag", tag);
+  const r = s.release();
+  assert.notEqual(r.status, 0);
+  assert.match(r.stderr, /already exists/);
+}));
+
+test("--dry-run prints steps without tagging", () => withSandbox((s) => {
+  const r = s.release("--dry-run");
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stdout, new RegExp(`\\+ git tag ${tag.replace(/\./g, "\\.")}`));
+  assert.equal(s.tags(), "");
+}));
