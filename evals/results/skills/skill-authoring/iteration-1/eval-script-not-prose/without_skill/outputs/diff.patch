+#!/usr/bin/env bash
+# Release: build, enforce bundle size, tag, generate changelog.
+# Stops at the first failing step, so nothing gets tagged if the bundle is too big.
+#
+# Usage: npm run release            (or: scripts/release.sh)
+#        MAX_KB=300 npm run release (override the bundle size limit)
+set -euo pipefail
+
+cd "$(dirname "$0")/.."
+
+MAX_KB="${MAX_KB:-250}"
+VERSION="$(node -p 'require("./package.json").version')"
+TAG="v${VERSION}"
+
+step() { printf '\n==> %s\n' "$*"; }
+
+if git rev-parse -q --verify "refs/tags/${TAG}" >/dev/null; then
+  echo "error: tag ${TAG} already exists — bump the version in package.json first." >&2
+  exit 1
+fi
+
+step "1/4 Build"
+npm run build
+
+step "2/4 Check bundle size (max ${MAX_KB} KB)"
+node scripts/check-bundle-size.js --max-kb "${MAX_KB}"
+
+step "3/4 Tag ${TAG}"
+git tag "${TAG}"
+
+step "4/4 Changelog"
+npm run changelog -- --since-last-tag
+
+printf '\nReleased %s. Push the tag when ready: git push origin %s\n' "${TAG}" "${TAG}"
