 export function subtotal(lines) {
   return lines.reduce((sum, l) => sum + l.priceCents * l.qty, 0);
 }
+
+export function discount(totalCents, code) {
+  if (code === 'SAVE10') return Math.round(totalCents * 0.9);
+  return totalCents;
+}
diff --git a/test/discount.test.js b/test/discount.test.js
new file mode 100644
index 0000000..27b55bb
--- /dev/null
+++ b/test/discount.test.js
@@ -0,0 +1,17 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { discount } from '../src/pricing.js';
+
+test('SAVE10 takes 10% off the total', () => {
+  assert.equal(discount(1000, 'SAVE10'), 900);
+});
+
+test('SAVE10 rounds the discounted total to the nearest cent', () => {
+  assert.equal(discount(999, 'SAVE10'), 899);  // 899.1 -> 899
+  assert.equal(discount(1004, 'SAVE10'), 904); // 903.6 -> 904
+});
+
+test('an unknown code leaves the total unchanged', () => {
+  assert.equal(discount(1000, 'BOGUS'), 1000);
+  assert.equal(discount(999, ''), 999);
+});
