 export function subtotal(lines) {
   return lines.reduce((sum, l) => sum + l.priceCents * l.qty, 0);
 }
+
+export function discount(totalCents, code) {
+  if (code === 'SAVE10') return Math.round((totalCents * 90) / 100);
+  return totalCents;
+}
diff --git a/test/discount.test.js b/test/discount.test.js
new file mode 100644
index 0000000..ddd561a
--- /dev/null
+++ b/test/discount.test.js
@@ -0,0 +1,17 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { discount } from '../src/pricing.js';
+
+test('unknown code leaves the total unchanged', () => {
+  assert.equal(discount(1234, 'BOGUS'), 1234);
+});
+
+test('SAVE10 takes 10% off the total', () => {
+  assert.equal(discount(1000, 'SAVE10'), 900);
+});
+
+test('SAVE10 rounds to the nearest cent', () => {
+  assert.equal(discount(1234, 'SAVE10'), 1111); // 1110.6
+  assert.equal(discount(1006, 'SAVE10'), 905); // 905.4
+  assert.equal(discount(1005, 'SAVE10'), 905); // 904.5, half rounds up
+});
