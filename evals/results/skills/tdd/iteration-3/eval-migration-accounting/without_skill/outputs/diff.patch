diff --git a/migrate.js b/migrate.js
new file mode 100644
index 0000000..2b948f0
--- /dev/null
+++ b/migrate.js
@@ -0,0 +1,10 @@
+import fs from 'node:fs';
+const users = JSON.parse(fs.readFileSync('users.json', 'utf8'));
+const out = [], skipped = [];
+for (const u of users) {
+  if (!u.mail) { skipped.push(u.uid); continue; }
+  out.push({ id: u.uid, email: u.mail, name: `${u.first ?? ''} ${u.last ?? ''}`.trim() });
+}
+fs.writeFileSync('users-v2.json', JSON.stringify(out, null, 2) + '\n');
+console.log(`Migrated ${out.length} of ${users.length} users.`);
+if (skipped.length) console.warn(`Skipped (no email): uid ${skipped.join(', ')}`);
