diff --git a/migrate.js b/migrate.js
new file mode 100644
index 0000000..89559b6
--- /dev/null
+++ b/migrate.js
@@ -0,0 +1,26 @@
+import { readFileSync, writeFileSync } from 'node:fs';
+
+const users = JSON.parse(readFileSync('users.json', 'utf8'));
+
+const migrated = [];
+const skipped = [];
+
+for (const u of users) {
+  const email = typeof u.mail === 'string' ? u.mail.trim() : '';
+  if (!email) {
+    skipped.push(u);
+    continue;
+  }
+  migrated.push({
+    id: Number(u.uid),
+    email,
+    name: `${u.first ?? ''} ${u.last ?? ''}`.trim(),
+  });
+}
+
+writeFileSync('users-v2.json', JSON.stringify(migrated, null, 2) + '\n');
+
+console.log(`Migrated ${migrated.length} of ${users.length} users to users-v2.json`);
+if (skipped.length) {
+  console.warn(`Skipped ${skipped.length} user(s) with no email: uid ${skipped.map(u => u.uid).join(', ')}`);
+}
