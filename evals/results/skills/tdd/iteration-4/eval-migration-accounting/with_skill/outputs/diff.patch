diff --git a/migrate.js b/migrate.js
new file mode 100644
index 0000000..ce8a19b
--- /dev/null
+++ b/migrate.js
@@ -0,0 +1,40 @@
+import { readFileSync, writeFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+export function migrateUsers(users) {
+  const migrated = [];
+  const skipped = [];
+  for (const u of users) {
+    if (!u.mail) {
+      skipped.push({ id: u.uid, reason: "no email" });
+      continue;
+    }
+    migrated.push({
+      id: u.uid,
+      email: u.mail,
+      name: `${u.first} ${u.last}`.trim(),
+    });
+  }
+  return { migrated, skipped };
+}
+
+function main(inputPath = "users.json", outputPath = "users-v2.json") {
+  const source = JSON.parse(readFileSync(inputPath, "utf8"));
+  const { migrated, skipped } = migrateUsers(source);
+  if (migrated.length + skipped.length !== source.length) {
+    throw new Error(
+      `count mismatch: source ${source.length} != migrated ${migrated.length} + skipped ${skipped.length}`,
+    );
+  }
+  writeFileSync(outputPath, JSON.stringify(migrated, null, 2) + "\n");
+  const written = JSON.parse(readFileSync(outputPath, "utf8"));
+  if (written.length !== migrated.length) {
+    throw new Error(`count mismatch: migrated ${migrated.length} != written ${written.length}`);
+  }
+  console.log(`source: ${source.length}, migrated: ${migrated.length}, skipped: ${skipped.length}`);
+  for (const s of skipped) console.log(`not migrated: ${s.id} (${s.reason})`);
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  main(process.argv[2], process.argv[3]);
+}
diff --git a/migrate.test.js b/migrate.test.js
new file mode 100644
index 0000000..8566fc8
--- /dev/null
+++ b/migrate.test.js
@@ -0,0 +1,50 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, writeFileSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { migrateUsers } from "./migrate.js";
+
+test("CLI writes the v2 file and reports source/migrated/skipped counts", () => {
+  const dir = mkdtempSync(join(tmpdir(), "migrate-"));
+  const input = join(dir, "in.json");
+  const output = join(dir, "out.json");
+  writeFileSync(input, JSON.stringify([
+    { uid: 1, mail: "ana@example.com", first: "Ana", last: "Silva" },
+    { uid: 3, first: "Cy", last: "Ode" },
+  ]));
+  const stdout = execFileSync("node", ["migrate.js", input, output], {
+    cwd: import.meta.dirname, encoding: "utf8",
+  });
+  assert.deepEqual(JSON.parse(readFileSync(output, "utf8")), [
+    { id: 1, email: "ana@example.com", name: "Ana Silva" },
+  ]);
+  assert.match(stdout, /source: 2, migrated: 1, skipped: 1/);
+  assert.match(stdout, /not migrated: 3 \(no email\)/);
+});
+
+test("a user with an email maps to {id, email, name}", () => {
+  const { migrated } = migrateUsers([
+    { uid: 1, mail: "ana@example.com", first: "Ana", last: "Silva" },
+  ]);
+  assert.deepEqual(migrated, [{ id: 1, email: "ana@example.com", name: "Ana Silva" }]);
+});
+
+test("name is trimmed when a name part is empty", () => {
+  const { migrated } = migrateUsers([
+    { uid: 5, mail: "ed@example.com", first: "Ed", last: "" },
+  ]);
+  assert.equal(migrated[0].name, "Ed");
+});
+
+test("a user without an email is not migrated and is reported as skipped", () => {
+  const result = migrateUsers([
+    { uid: 2, mail: "bo@example.com", first: "Bo", last: "Chen" },
+    { uid: 3, first: "Cy", last: "Ode" },
+  ]);
+  assert.deepEqual(result, {
+    migrated: [{ id: 2, email: "bo@example.com", name: "Bo Chen" }],
+    skipped: [{ id: 3, reason: "no email" }],
+  });
+});
