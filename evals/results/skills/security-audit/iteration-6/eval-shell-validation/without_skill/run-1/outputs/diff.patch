+[
+  {
+    "verdict": "confirmed",
+    "request": {"path": "/api/log", "params": {"branch": "main; cat /proc/self/environ; id"}},
+    "file": "app/tasks.py",
+    "line": 23,
+    "why": "BRANCH_RE is only anchored at the start (re.match with no $ / fullmatch), so 'main; <cmd>' passes validation (verified: BRANCH_RE.match('main; cat /etc/passwd') is truthy). The value is interpolated into an f-string run by subprocess.run(shell=True) in _git (line 11), giving any signed-in employee arbitrary OS command execution as the service account on the ops host (access to /srv/ops/repo, server secrets such as DEPLOY_TOKEN, etc.). stdout is returned in the response."
+  },
