+[
+  {
+    "verdict": "confirmed",
+    "request": { "method": "GET", "path": "/invoices/inv_1002/pdf", "token": "tok_alice_7f3a" },
+    "file": "src/app.js",
+    "line": 6,
+    "why": "requireOwner is mounted with router.use('/invoices/:id'), which compile() in src/router.js:73 turns into the fully anchored regex ^/invoices/([^/]+)$. It runs only on the exact /invoices/:id path and never on /invoices/:id/pdf. getInvoicePdf (src/invoices.js:54-58) checks only that the invoice exists, not who owns it. Run locally, Alice's token returned 200 with Bob's inv_1002 PDF (Customer cust_bob, Consulting 990.00, Total 990.00). Fix: add the ownership check to getInvoicePdf, or make the guard cover the /pdf route too (for example, also register requireOwner on '/invoices/:id/pdf')."
+  },
