+    "verdict": "rejected",
+    "request": { "method": "GET", "path": "/invoices/inv_1002", "token": "tok_alice_7f3a" },
+    "file": "src/invoices.js",
+    "line": 45,
+    "why": "getInvoice has no ownership check of its own, but the requireOwner layer (src/app.js:6) is registered before it with the same pattern, runs for every method, and returns 403 before getInvoice is reached. The local run returned 403 forbidden."
