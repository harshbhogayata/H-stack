+    "file": "src/router.js",
+    "line": 94,
+    "why": "A percent-encoded slash matches both patterns, and the guard and the handler see the same decoded id ('inv_1002/'). No invoice has that id, so requireOwner returns 404. The local run returned 404."
+  },
