@@ -0,0 +1,29 @@
+const test = require('node:test'); const assert = require('node:assert');
+const { createLimiter } = require('../limiter');
+
+test('fractional refill accumulates', () => {
+  const a = createLimiter({ capacity: 1, refillPerSec: 2 });
+  assert.ok(a('k', 0)); assert.ok(!a('k', 0));
+  assert.ok(!a('k', 250)); // 0.5 token
+  assert.ok(a('k', 500));  // 1.0 token
+  assert.ok(!a('k', 500));
+});
+
+test('refill never exceeds capacity', () => {
+  const a = createLimiter({ capacity: 2, refillPerSec: 1 });
+  assert.ok(a('k', 0)); assert.ok(a('k', 0));
+  assert.ok(a('k', 100000)); assert.ok(a('k', 100000)); assert.ok(!a('k', 100000));
+});
+
+test('keys are independent', () => {
+  const a = createLimiter({ capacity: 1, refillPerSec: 1 });
+  assert.ok(a('x', 0)); assert.ok(!a('x', 0)); assert.ok(a('y', 0));
+});
+
+test('backwards time counts as no time passing', () => {
+  const a = createLimiter({ capacity: 1, refillPerSec: 1 });
+  assert.ok(a('k', 5000)); assert.ok(!a('k', 5000));
+  assert.ok(!a('k', 1000));  // went backwards: no refill
+  assert.ok(!a('k', 5999));  // still measured from 5000, not 1000
+  assert.ok(a('k', 6000));
+});
