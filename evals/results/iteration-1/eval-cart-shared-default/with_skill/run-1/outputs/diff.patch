diff --git a/test/defaults.test.js b/test/defaults.test.js
new file mode 100644
index 0000000..5529ffc
--- /dev/null
+++ b/test/defaults.test.js
@@ -0,0 +1,11 @@
+const test = require('node:test'); const assert = require('node:assert');
+const { createCart } = require('../lib/cart');
+const { getDefaults } = require('../lib/settings');
+test('customer prefs never leak into shared defaults', () => {
+  const before = { ...getDefaults() };
+  createCart({ name: 'ann', prefs: { currency: 'USD', taxRate: 0 } });
+  assert.deepStrictEqual(getDefaults(), before);
+});
+test('shared defaults cannot be mutated', () => {
+  assert.throws(() => { 'use strict'; getDefaults().currency = 'USD'; }, TypeError);
+});
