diff --git a/test/stats-json.test.js b/test/stats-json.test.js
new file mode 100644
index 0000000..8a50e95
--- /dev/null
+++ b/test/stats-json.test.js
@@ -0,0 +1,17 @@
+const test = require('node:test'); const assert = require('node:assert'); const { execFileSync, spawnSync } = require('child_process');
+const fs = require('fs'); const os = require('os'); const path = require('path');
+const f = path.join(os.tmpdir(), 'nums-json.txt');
+for (const where of ['before', 'after']) {
+  test(`--json ${where} the file argument`, () => {
+    fs.writeFileSync(f, '1 2 3');
+    const argv = where === 'before' ? ['--json', f] : [f, '--json'];
+    const out = execFileSync('node', ['bin/stats.js', ...argv], { encoding: 'utf8' });
+    assert.deepStrictEqual(JSON.parse(out), { count: 3, mean: 2 });
+  });
+}
+test('--json error: nothing on stdout, message on stderr, exit 2', () => {
+  const r = spawnSync('node', ['bin/stats.js', '--json', '/nonexistent/x'], { encoding: 'utf8' });
+  assert.strictEqual(r.status, 2);
+  assert.strictEqual(r.stdout, '');
+  assert.match(r.stderr, /^stats: cannot read \/nonexistent\/x: ENOENT/);
+});
