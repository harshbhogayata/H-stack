diff --git a/test/settings.test.js b/test/settings.test.js
new file mode 100644
index 0000000..20803bf
--- /dev/null
+++ b/test/settings.test.js
@@ -0,0 +1,12 @@
+'use strict';
+const test = require('node:test'); const assert = require('node:assert');
+const { createCart } = require('../lib/cart');
+const { getDefaults } = require('../lib/settings');
+test('customer prefs never leak into shop defaults', () => {
+  createCart({ name: 'ann', prefs: { currency: 'USD', taxRate: 0 } });
+  assert.deepStrictEqual(getDefaults(), { currency: 'EUR', taxRate: 0.2 });
+});
+test('shop defaults cannot be mutated by callers', () => {
+  assert.throws(() => { getDefaults().currency = 'USD'; }, TypeError);
+  assert.strictEqual(getDefaults().currency, 'EUR');
+});
