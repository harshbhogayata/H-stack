@@ -0,0 +1,15 @@
+const test = require('node:test'); const assert = require('node:assert');
+const { getDefaults } = require('../lib/settings');
+const { createCart, refund } = require('../lib/cart');
+
+test('mutating returned defaults does not leak into later calls', () => {
+  const d = getDefaults();
+  d.currency = 'XXX';
+  assert.strictEqual(getDefaults().currency, 'EUR');
+});
+
+test('per-customer prefs do not change shop defaults', () => {
+  createCart({ name: 'bob', prefs: { currency: 'USD' } });
+  assert.strictEqual(getDefaults().currency, 'EUR');
+  assert.strictEqual(refund(1).currency, 'EUR');
+});
