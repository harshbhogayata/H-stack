+for (const args of [['--json', 'F'], ['F', '--json']]) {
+  test(`json output (${args.join(' ')})`, () => {
+    const f = path.join(os.tmpdir(), 'nums.txt'); fs.writeFileSync(f, '1 2 3');
+    const out = execFileSync('node', ['bin/stats.js', ...args.map(a => a === 'F' ? f : a)], { encoding: 'utf8' });
+    assert.deepStrictEqual(JSON.parse(out), { count: 3, mean: 2 });
+    assert.strictEqual(out.trim().split('\n').length, 1);
+  });
+}
+test('json error: nothing on stdout, exit 2', () => {
+  const r = require('child_process').spawnSync('node', ['bin/stats.js', '--json', '/nonexistent/x'], { encoding: 'utf8' });
+  assert.strictEqual(r.status, 2);
+  assert.strictEqual(r.stdout, '');
+  assert.match(r.stderr, /^stats: cannot read \/nonexistent\/x: ENOENT/);
+});
