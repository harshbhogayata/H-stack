+++ b/src/formatGreeting.test.js
@@ -0,0 +1,17 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { formatGreeting } from './formatGreeting.js';
+
+test('greets a user by display name', () => {
+  assert.equal(formatGreeting('Ada Lovelace'), 'Hello, Ada Lovelace!');
+});
+
+test('trims surrounding whitespace from the display name', () => {
+  assert.equal(formatGreeting('  Ada  '), 'Hello, Ada!');
+});
+
+test('falls back to a generic greeting for a missing or blank name', () => {
+  assert.equal(formatGreeting(''), 'Hello!');
+  assert.equal(formatGreeting('   '), 'Hello!');
+  assert.equal(formatGreeting(undefined), 'Hello!');
+});
