diff --git a/components/StatusBadge.jsx b/components/StatusBadge.jsx
new file mode 100644
index 0000000..123d8fc
--- /dev/null
+++ b/components/StatusBadge.jsx
@@ -0,0 +1,8 @@
+import './StatusBadge.css';
+
+const LABELS = { ok: 'OK', warn: 'Warning', error: 'Error' };
+
+export function StatusBadge({ status, children }) {
+  const s = status in LABELS ? status : 'error';
+  return <span className={`status-badge status-badge--${s}`}>{children ?? LABELS[s]}</span>;
+}
