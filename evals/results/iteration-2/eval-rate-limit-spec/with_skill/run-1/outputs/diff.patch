 function createLimiter({ capacity, refillPerSec }) {
-  // TODO: implement as described in README.md
-  return function allow(key, nowMs) { return true; };
+  const buckets = new Map(); // key -> { tokens, last }
+  const EPS = 1e-9; // absorbs float drift, e.g. 0.1 * 10 landing at 0.9999999
+
+  return function allow(key, nowMs) {
+    let b = buckets.get(key);
+    if (!b) {
+      b = { tokens: capacity, last: nowMs };
+      buckets.set(key, b);
+    } else if (nowMs > b.last) {
+      const refill = ((nowMs - b.last) / 1000) * refillPerSec;
+      b.tokens = Math.min(capacity, b.tokens + refill);
+      b.last = nowMs;
+    }
+    // nowMs <= b.last: no time passes, and `last` stays at the latest time seen.
+
+    if (b.tokens + EPS >= 1) {
+      b.tokens = Math.max(0, b.tokens - 1);
+      return true;
+    }
+    return false;
+  };
 }
 module.exports = { createLimiter };
